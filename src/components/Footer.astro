---
// src/components/Footer.astro
// Design decision: close the document like a spec sheet colophon — a top rule,
// label-headed columns, and a final metadata line. No cards, no shadows.
import Logo from '@/components/Logo.astro';

const year = new Date().getFullYear();

const siteLinks = [
  { href: '/projects', label: 'work' },
  { href: '/resume', label: 'resume' },
  { href: '/about', label: 'about' },
  { href: '/blog', label: 'blog' },
  // Not in the nav. A colophon is end matter, and a fifth top-level tab would give it
  // the same weight as the work. The footer and the hero legend are the right traffic.
  { href: '/colophon', label: 'colophon' },
];

const elsewhereLinks = [
  { href: 'https://github.com/rmerk', label: 'github', external: true },
  { href: 'https://www.linkedin.com/in/ryanchoimn/', label: 'linkedin', external: true },
  { href: 'mailto:ryan@ryanchoi.dev', label: 'email', external: false },
];
---

<footer class="mt-24 border-t border-border">
  <div class="mx-auto max-w-5xl px-5 sm:px-8">
    <div class="grid grid-cols-2 gap-x-8 gap-y-10 py-12 sm:grid-cols-4">
      <!-- Identity -->
      <div class="col-span-2">
        <a
          href="/"
          class="group inline-flex items-center gap-2.5"
        >
          <span class="flex h-7 w-7 items-center justify-center border border-border-strong text-muted transition-colors group-hover:border-accent group-hover:text-accent">
            <Logo class="h-3.5 w-auto" />
          </span>
          <span class="label text-text">Ryan Choi</span>
        </a>
        <p class="mt-4 max-w-xs text-sm leading-6 text-muted">
          Senior Full-Stack Engineer. Vue, React, Node.js, PHP, and design systems.
        </p>
      </div>

      <!-- Site -->
      <nav aria-label="Footer">
        <h2 class="label text-muted-soft">Site</h2>
        <ul class="mt-4 space-y-2.5">
          {siteLinks.map(({ href, label }) => (
            <li>
              <a
                href={href}
                class="rule-link text-sm text-muted transition-colors hover:text-text"
              >
                {label}
              </a>
            </li>
          ))}
        </ul>
      </nav>

      <!-- Elsewhere -->
      <div>
        <h2 class="label text-muted-soft">Elsewhere</h2>
        <ul class="mt-4 space-y-2.5">
          {elsewhereLinks.map(({ href, label, external }) => (
            <li>
              <a
                href={href}
                target={external ? '_blank' : undefined}
                rel={external ? 'noopener noreferrer' : undefined}
                class="rule-link text-sm text-muted transition-colors hover:text-text"
              >
                {label}
              </a>
            </li>
          ))}
        </ul>
      </div>
    </div>

    <!-- Colophon -->
    <div class="flex flex-col gap-2 border-t border-border py-6 sm:flex-row sm:items-center sm:justify-between">
      <p class="label text-muted-soft">&copy; {year} Ryan Choi</p>
      <p class="label text-muted-soft">Astro &middot; Tailwind CSS &middot; Static</p>
    </div>
  </div>
</footer>
