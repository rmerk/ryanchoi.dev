---
// src/components/GitHubSection.astro
// Design decision: present GitHub activity as an instrument panel — a ruled stat
// strip, one inset surface for the contribution grid, and everything else as
// aligned data rows. Build-time fetched, with fallbacks so the build never fails.
import SectionHeader from '@/components/SectionHeader.astro';

interface GitHubProfile {
  avatar_url: string;
  public_repos: number;
  followers: number;
  bio: string | null;
  html_url: string;
}

interface GitHubEvent {
  type: string;
  repo: { name: string };
  created_at: string;
}

interface GitHubActivityItem {
  repo: string;
  type: string;
  timeAgo: string;
}

interface GitHubRepo {
  name: string;
  description: string | null;
  html_url: string;
  stargazers_count: number;
  forks_count: number;
  language: string | null;
}

interface GitHubGraphQLResponse {
  data?: {
    user?: {
      contributionsCollection?: {
        contributionCalendar?: {
          totalContributions?: number;
          weeks?: ContributionWeek[];
        };
      };
      repositories?: {
        nodes?: {
          languages?: {
            edges?: {
              size?: number;
              node?: { name?: string };
            }[];
          };
        }[];
      };
    };
  };
}

const fallbackProfile: GitHubProfile = {
  avatar_url: 'https://github.com/rmerk.png',
  public_repos: 30,
  followers: 15,
  bio: 'Senior Frontend Engineer',
  html_url: 'https://github.com/rmerk',
};

const fallbackRecentActivity: GitHubActivityItem[] = [
  { repo: 'ryanchoi-dev', type: 'Maintains', timeAgo: 'portfolio' },
  { repo: 'clearstack-dev', type: 'Maintains', timeAgo: 'client work' },
];

const fallbackRepos: GitHubRepo[] = [
  {
    name: 'ryanchoi-dev',
    description: 'Personal portfolio and blog built with Astro, TypeScript, and Tailwind CSS.',
    html_url: 'https://github.com/rmerk/ryanchoi-dev',
    stargazers_count: 0,
    forks_count: 0,
    language: 'TypeScript',
  },
  {
    name: 'clearstack-dev',
    description: 'Marketing site for a software agency serving small businesses in Minnesota.',
    html_url: 'https://github.com/rmerk/clearstack-dev',
    stargazers_count: 0,
    forks_count: 0,
    language: 'Astro',
  },
];

const fallbackLanguages = ['TypeScript', 'Astro', 'CSS'];

interface ContributionDay {
  contributionCount: number;
  date: string;
}

interface ContributionWeek {
  contributionDays: ContributionDay[];
}

let contributionWeeks: ContributionWeek[] = [];
let totalContributions = 0;
let graphqlLanguages: string[] = [];

const GITHUB_TOKEN = import.meta.env.GITHUB_TOKEN;
const restHeaders = { 'User-Agent': 'ryanchoi-dev' };
const eventTypeLabels: Record<string, string> = {
  PushEvent: 'Pushed to',
  CreateEvent: 'Created',
  PullRequestEvent: 'PR on',
  IssuesEvent: 'Issue on',
  WatchEvent: 'Starred',
  ForkEvent: 'Forked',
};

async function readJsonResponse<T>(response: Response): Promise<T | null> {
  if (!response.ok) return null;

  try {
    return (await response.json()) as T;
  } catch {
    return null;
  }
}

async function fetchJson<T>(url: string, init?: RequestInit): Promise<T | null> {
  try {
    return await readJsonResponse<T>(await fetch(url, init));
  } catch {
    return null;
  }
}

function getTimeAgo(createdAt: string, now: number): string {
  const diff = now - new Date(createdAt).getTime();
  const hours = Math.floor(diff / (1000 * 60 * 60));
  const days = Math.floor(hours / 24);

  if (days > 0) return `${days}d ago`;
  if (hours > 0) return `${hours}h ago`;
  return 'just now';
}

function isRecord(value: unknown): value is Record<string, unknown> {
  return typeof value === 'object' && value !== null;
}

function isGitHubEvent(value: unknown): value is GitHubEvent {
  if (!isRecord(value) || !isRecord(value.repo)) return false;

  return (
    typeof value.type === 'string' &&
    typeof value.repo.name === 'string' &&
    typeof value.created_at === 'string'
  );
}

function isGitHubRepo(value: unknown): value is GitHubRepo {
  if (!isRecord(value)) return false;

  return (
    typeof value.name === 'string' &&
    (typeof value.description === 'string' || value.description === null) &&
    typeof value.html_url === 'string' &&
    typeof value.stargazers_count === 'number' &&
    typeof value.forks_count === 'number' &&
    (typeof value.language === 'string' || value.language === null)
  );
}

function isContributionDay(value: unknown): value is ContributionDay {
  return isRecord(value) && typeof value.contributionCount === 'number' && typeof value.date === 'string';
}

function isContributionWeek(value: unknown): value is ContributionWeek {
  return (
    isRecord(value) &&
    Array.isArray(value.contributionDays) &&
    value.contributionDays.every(isContributionDay)
  );
}

function isLanguageEdge(value: unknown): value is { size: number; node: { name: string } } {
  return (
    isRecord(value) &&
    typeof value.size === 'number' &&
    isRecord(value.node) &&
    typeof value.node.name === 'string'
  );
}

function resolveProfile(data: Partial<GitHubProfile> | null): GitHubProfile {
  if (!data) return { ...fallbackProfile };

  return {
    avatar_url: data.avatar_url || fallbackProfile.avatar_url,
    public_repos: typeof data.public_repos === 'number' ? data.public_repos : fallbackProfile.public_repos,
    followers: typeof data.followers === 'number' ? data.followers : fallbackProfile.followers,
    bio: data.bio ?? fallbackProfile.bio,
    html_url: data.html_url || fallbackProfile.html_url,
  };
}

function resolveRecentActivity(events: unknown): GitHubActivityItem[] {
  const validEvents = Array.isArray(events) ? events.filter(isGitHubEvent) : [];
  if (validEvents.length === 0) return [...fallbackRecentActivity];

  const now = Date.now();

  return validEvents.slice(0, 5).map((event) => {
    return {
      repo: event.repo.name.split('/').pop() || event.repo.name,
      type: eventTypeLabels[event.type] || event.type.replace('Event', ''),
      timeAgo: getTimeAgo(event.created_at, now),
    };
  });
}

function resolveRepos(data: unknown): GitHubRepo[] {
  const validRepos = Array.isArray(data) ? data.filter(isGitHubRepo) : [];
  return validRepos.length > 0 ? validRepos : [...fallbackRepos];
}

const [profileData, eventsData, reposData] = await Promise.all([
  fetchJson<Partial<GitHubProfile>>('https://api.github.com/users/rmerk', { headers: restHeaders }),
  fetchJson<unknown[]>('https://api.github.com/users/rmerk/events?per_page=5', { headers: restHeaders }),
  fetchJson<unknown[]>('https://api.github.com/users/rmerk/repos?sort=stars&per_page=6&direction=desc', { headers: restHeaders }),
]);

const profile = resolveProfile(profileData);
const recentActivity = resolveRecentActivity(eventsData);
const repos = resolveRepos(reposData);

if (GITHUB_TOKEN) {
  const gql = await fetchJson<GitHubGraphQLResponse>('https://api.github.com/graphql', {
    method: 'POST',
    headers: {
      'Authorization': `bearer ${GITHUB_TOKEN}`,
      'Content-Type': 'application/json',
      'User-Agent': 'ryanchoi-dev',
    },
    body: JSON.stringify({
      query: `{
        user(login: "rmerk") {
          contributionsCollection {
            contributionCalendar {
              totalContributions
              weeks {
                contributionDays {
                  contributionCount
                  date
                }
              }
            }
          }
          repositories(first: 100, ownerAffiliations: OWNER, isFork: false) {
            nodes {
              languages(first: 5, orderBy: { field: SIZE, direction: DESC }) {
                edges {
                  size
                  node { name }
                }
              }
            }
          }
        }
      }`,
    }),
  });

  const user = gql?.data?.user;
  const calendar = user?.contributionsCollection?.contributionCalendar;
  const validWeeks = Array.isArray(calendar?.weeks) ? calendar.weeks.filter(isContributionWeek) : [];
  if (typeof calendar?.totalContributions === 'number' && validWeeks.length > 0) {
    totalContributions = calendar.totalContributions;
    contributionWeeks = validWeeks;
  }

  // Aggregate language bytes across all repos when GraphQL data is available.
  const langBytes = new Map<string, number>();
  const repoNodes = Array.isArray(user?.repositories?.nodes) ? user.repositories.nodes : [];
  for (const repo of repoNodes) {
    const languageEdges = Array.isArray(repo?.languages?.edges) ? repo.languages.edges : [];
    for (const edge of languageEdges.filter(isLanguageEdge)) {
      langBytes.set(edge.node.name, (langBytes.get(edge.node.name) || 0) + edge.size);
    }
  }
  if (langBytes.size > 0) {
    graphqlLanguages = [...langBytes.entries()]
      .sort((a, b) => b[1] - a[1])
      .map(([name]) => name);
  }
}

// Map contribution count to intensity level (0-4)
function getContributionLevel(count: number): number {
  if (count === 0) return 0;
  if (count <= 3) return 1;
  if (count <= 6) return 2;
  if (count <= 9) return 3;
  return 4;
}

// Language and event-type dots used to be an arbitrary rainbow of Tailwind colors.
// In a single-accent system the label carries the meaning, so intensity is the only
// thing still expressed in color — here, on the contribution grid.
const contributionColors = [
  'bg-surface-raised',
  'bg-accent/25',
  'bg-accent/45',
  'bg-accent/70',
  'bg-accent',
];

// Frontend languages first, then backend, then everything else
const frontendLangs = new Set(['TypeScript', 'JavaScript', 'Vue', 'CSS', 'HTML', 'Astro', 'Svelte', 'SCSS', 'Sass', 'Less']);
const backendLangs = new Set(['Python', 'Ruby', 'PHP', 'Go', 'Rust', 'Java', 'Kotlin', 'Swift', 'C#', 'C++', 'C']);

function sortByCategory(langs: string[]): string[] {
  const frontend = langs.filter((l) => frontendLangs.has(l));
  const backend = langs.filter((l) => backendLangs.has(l));
  const other = langs.filter((l) => !frontendLangs.has(l) && !backendLangs.has(l));
  return [...frontend, ...backend, ...other];
}

function getRestLanguages(sourceRepos: GitHubRepo[]): string[] {
  const languageCounts = new Map<string, number>();
  for (const repo of sourceRepos) {
    if (repo.language) {
      languageCounts.set(repo.language, (languageCounts.get(repo.language) || 0) + 1);
    }
  }

  const languages = sortByCategory(
    [...languageCounts.entries()]
      .sort((a, b) => b[1] - a[1])
      .map(([name]) => name)
  );

  return languages.length > 0 ? languages : fallbackLanguages;
}

// Capped: the GraphQL aggregate returns every language ever committed, which tails
// off into noise (PureBasic, G-code) and buries the signal in a flat mono list.
const LANGUAGE_LIMIT = 10;
const languages = (graphqlLanguages.length > 0 ? sortByCategory(graphqlLanguages) : getRestLanguages(repos))
  .slice(0, LANGUAGE_LIMIT);

const stats: { key: string; value: string }[] = [
  { key: 'Repositories', value: String(profile.public_repos) },
  { key: 'Followers', value: String(profile.followers) },
  ...(totalContributions > 0
    ? [{ key: 'Contributions', value: totalContributions.toLocaleString('en-US') }]
    : []),
];
---

<section class="py-16 sm:py-20">
  <SectionHeader
    index="03"
    eyebrow="Open source"
    title="Recent engineering signal"
    description="A build-time snapshot of public repositories, language mix, and contribution activity."
    href={profile.html_url}
    linkLabel="View profile"
  />

  <!-- Stat strip -->
  <dl class="mt-10 grid grid-cols-2 border-t border-border sm:grid-cols-3">
    {stats.map(({ key, value }) => (
      <div class="border-b border-border py-5 pr-6">
        <dt class="label text-muted-soft">{key}</dt>
        <dd class="mt-2 font-mono text-2xl font-medium tabular-nums text-text">{value}</dd>
      </div>
    ))}
  </dl>

  <!-- Contribution grid -->
  {contributionWeeks.length > 0 && (
    <div class="mt-12">
      <div class="flex items-baseline justify-between gap-4 border-t border-border pt-4">
        <h3 class="label text-muted-soft">Contributions</h3>
        <span class="label text-muted">{totalContributions.toLocaleString('en-US')} in the last year</span>
      </div>
      <div class="mt-4 overflow-x-auto border border-border bg-surface p-4">
        <div
          class="flex gap-[3px]"
          role="img"
          aria-label={`Contribution activity: ${totalContributions} contributions in the last year`}
        >
          {contributionWeeks.map((week) => (
            <div class="flex flex-col gap-[3px]">
              {week.contributionDays.map((day) => (
                <div
                  class={`h-[10px] w-[10px] rounded-sm ${contributionColors[getContributionLevel(day.contributionCount)]}`}
                  title={`${day.contributionCount} contributions on ${day.date}`}
                />
              ))}
            </div>
          ))}
        </div>
        <div class="mt-3 flex items-center justify-end gap-1.5" aria-hidden="true">
          <span class="label text-muted-soft">Less</span>
          {contributionColors.map((color) => (
            <div class={`h-[10px] w-[10px] rounded-sm ${color}`} />
          ))}
          <span class="label text-muted-soft">More</span>
        </div>
      </div>
    </div>
  )}

  <!-- Popular repositories -->
  <div class="mt-12">
    <h3 class="label border-t border-border pt-4 text-muted-soft">Popular repositories</h3>
    <div class="mt-2 grid sm:grid-cols-2 sm:gap-x-10">
      {repos.slice(0, 6).map((repo) => (
        <div class="group border-b border-border py-5">
          <p class="text-sm font-semibold text-text">
            <a
              href={repo.html_url}
              target="_blank"
              rel="noopener noreferrer"
              class="rule-link transition-colors hover:text-accent"
            >
              {repo.name}
            </a>
          </p>
          {repo.description && (
            <p class="mt-2 line-clamp-2 text-sm leading-6 text-muted">{repo.description}</p>
          )}
          <p class="label mt-3 text-muted-soft">
            {repo.language && <span>{repo.language}</span>}
            {repo.language && (repo.stargazers_count > 0 || repo.forks_count > 0) && (
              <span class="mx-2 text-border-strong" aria-hidden="true">/</span>
            )}
            {repo.stargazers_count > 0 && <span>{repo.stargazers_count} stars</span>}
            {repo.stargazers_count > 0 && repo.forks_count > 0 && (
              <span class="mx-2 text-border-strong" aria-hidden="true">/</span>
            )}
            {repo.forks_count > 0 && <span>{repo.forks_count} forks</span>}
          </p>
        </div>
      ))}
    </div>
  </div>

  <!-- Languages + activity -->
  <div class="mt-12 grid gap-10 sm:grid-cols-2 sm:gap-x-10">
    {languages.length > 0 && (
      <div>
        <h3 class="label border-t border-border pt-4 text-muted-soft">Languages</h3>
        <ul class="mt-4 flex flex-wrap gap-x-2 gap-y-1.5">
          {languages.map((lang, i) => (
            <li class="label text-text">
              {lang}
              {i < languages.length - 1 && <span class="ml-2 text-border-strong" aria-hidden="true">/</span>}
            </li>
          ))}
        </ul>
      </div>
    )}

    {recentActivity.length > 0 && (
      <div>
        <h3 class="label border-t border-border pt-4 text-muted-soft">Recent activity</h3>
        <ul class="mt-2">
          {recentActivity.map(({ repo, type, timeAgo }) => (
            <li class="flex items-baseline justify-between gap-4 border-b border-border py-2.5">
              <span class="min-w-0 text-sm text-muted">
                {type} <span class="font-medium text-text">{repo}</span>
              </span>
              <span class="label shrink-0 text-muted-soft">{timeAgo}</span>
            </li>
          ))}
        </ul>
      </div>
    )}
  </div>
</section>
