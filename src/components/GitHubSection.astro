---
// src/components/GitHubSection.astro
// Design decision: present GitHub activity as a clean engineering dashboard,
// with consistent cards, restrained data color, and resilient build-time data.

interface GitHubProfile {
  avatar_url: string;
  public_repos: number;
  followers: number;
  bio: string | null;
  html_url: string;
}

interface GitHubEvent {
  type: string;
  repo: { name: string };
  created_at: string;
}

interface GitHubActivityItem {
  repo: string;
  type: string;
  timeAgo: string;
}

interface GitHubRepo {
  name: string;
  description: string | null;
  html_url: string;
  stargazers_count: number;
  forks_count: number;
  language: string | null;
}

interface GitHubGraphQLResponse {
  data?: {
    user?: {
      contributionsCollection?: {
        contributionCalendar?: {
          totalContributions?: number;
          weeks?: ContributionWeek[];
        };
      };
      repositories?: {
        nodes?: {
          languages?: {
            edges?: {
              size?: number;
              node?: { name?: string };
            }[];
          };
        }[];
      };
    };
  };
}

const fallbackProfile: GitHubProfile = {
  avatar_url: 'https://github.com/rmerk.png',
  public_repos: 30,
  followers: 15,
  bio: 'Senior Frontend Engineer',
  html_url: 'https://github.com/rmerk',
};

const fallbackRecentActivity: GitHubActivityItem[] = [
  { repo: 'ryanchoi-dev', type: 'Maintains', timeAgo: 'portfolio' },
  { repo: 'clearstack-dev', type: 'Maintains', timeAgo: 'client work' },
];

const fallbackRepos: GitHubRepo[] = [
  {
    name: 'ryanchoi-dev',
    description: 'Personal portfolio and blog built with Astro, TypeScript, and Tailwind CSS.',
    html_url: 'https://github.com/rmerk/ryanchoi-dev',
    stargazers_count: 0,
    forks_count: 0,
    language: 'TypeScript',
  },
  {
    name: 'clearstack-dev',
    description: 'Marketing site for a software agency serving small businesses in Minnesota.',
    html_url: 'https://github.com/rmerk/clearstack-dev',
    stargazers_count: 0,
    forks_count: 0,
    language: 'Astro',
  },
];

const fallbackLanguages = ['TypeScript', 'Astro', 'CSS'];

interface ContributionDay {
  contributionCount: number;
  date: string;
}

interface ContributionWeek {
  contributionDays: ContributionDay[];
}

let contributionWeeks: ContributionWeek[] = [];
let totalContributions = 0;
let graphqlLanguages: string[] = [];

const GITHUB_TOKEN = import.meta.env.GITHUB_TOKEN;
const restHeaders = { 'User-Agent': 'ryanchoi-dev' };
const eventTypeLabels: Record<string, string> = {
  PushEvent: 'Pushed to',
  CreateEvent: 'Created',
  PullRequestEvent: 'PR on',
  IssuesEvent: 'Issue on',
  WatchEvent: 'Starred',
  ForkEvent: 'Forked',
};

async function readJsonResponse<T>(response: Response): Promise<T | null> {
  if (!response.ok) return null;

  try {
    return (await response.json()) as T;
  } catch {
    return null;
  }
}

async function fetchJson<T>(url: string, init?: RequestInit): Promise<T | null> {
  try {
    return await readJsonResponse<T>(await fetch(url, init));
  } catch {
    return null;
  }
}

function getTimeAgo(createdAt: string, now: number): string {
  const diff = now - new Date(createdAt).getTime();
  const hours = Math.floor(diff / (1000 * 60 * 60));
  const days = Math.floor(hours / 24);

  if (days > 0) return `${days}d ago`;
  if (hours > 0) return `${hours}h ago`;
  return 'just now';
}

function isRecord(value: unknown): value is Record<string, unknown> {
  return typeof value === 'object' && value !== null;
}

function isGitHubEvent(value: unknown): value is GitHubEvent {
  if (!isRecord(value) || !isRecord(value.repo)) return false;

  return (
    typeof value.type === 'string' &&
    typeof value.repo.name === 'string' &&
    typeof value.created_at === 'string'
  );
}

function isGitHubRepo(value: unknown): value is GitHubRepo {
  if (!isRecord(value)) return false;

  return (
    typeof value.name === 'string' &&
    (typeof value.description === 'string' || value.description === null) &&
    typeof value.html_url === 'string' &&
    typeof value.stargazers_count === 'number' &&
    typeof value.forks_count === 'number' &&
    (typeof value.language === 'string' || value.language === null)
  );
}

function isContributionDay(value: unknown): value is ContributionDay {
  return isRecord(value) && typeof value.contributionCount === 'number' && typeof value.date === 'string';
}

function isContributionWeek(value: unknown): value is ContributionWeek {
  return (
    isRecord(value) &&
    Array.isArray(value.contributionDays) &&
    value.contributionDays.every(isContributionDay)
  );
}

function isLanguageEdge(value: unknown): value is { size: number; node: { name: string } } {
  return (
    isRecord(value) &&
    typeof value.size === 'number' &&
    isRecord(value.node) &&
    typeof value.node.name === 'string'
  );
}

function resolveProfile(data: Partial<GitHubProfile> | null): GitHubProfile {
  if (!data) return { ...fallbackProfile };

  return {
    avatar_url: data.avatar_url || fallbackProfile.avatar_url,
    public_repos: typeof data.public_repos === 'number' ? data.public_repos : fallbackProfile.public_repos,
    followers: typeof data.followers === 'number' ? data.followers : fallbackProfile.followers,
    bio: data.bio ?? fallbackProfile.bio,
    html_url: data.html_url || fallbackProfile.html_url,
  };
}

function resolveRecentActivity(events: unknown): GitHubActivityItem[] {
  const validEvents = Array.isArray(events) ? events.filter(isGitHubEvent) : [];
  if (validEvents.length === 0) return [...fallbackRecentActivity];

  const now = Date.now();

  return validEvents.slice(0, 5).map((event) => {
    return {
      repo: event.repo.name.split('/').pop() || event.repo.name,
      type: eventTypeLabels[event.type] || event.type.replace('Event', ''),
      timeAgo: getTimeAgo(event.created_at, now),
    };
  });
}

function resolveRepos(data: unknown): GitHubRepo[] {
  const validRepos = Array.isArray(data) ? data.filter(isGitHubRepo) : [];
  return validRepos.length > 0 ? validRepos : [...fallbackRepos];
}

const [profileData, eventsData, reposData] = await Promise.all([
  fetchJson<Partial<GitHubProfile>>('https://api.github.com/users/rmerk', { headers: restHeaders }),
  fetchJson<unknown[]>('https://api.github.com/users/rmerk/events?per_page=5', { headers: restHeaders }),
  fetchJson<unknown[]>('https://api.github.com/users/rmerk/repos?sort=stars&per_page=6&direction=desc', { headers: restHeaders }),
]);

const profile = resolveProfile(profileData);
const recentActivity = resolveRecentActivity(eventsData);
const repos = resolveRepos(reposData);

if (GITHUB_TOKEN) {
  const gql = await fetchJson<GitHubGraphQLResponse>('https://api.github.com/graphql', {
    method: 'POST',
    headers: {
      'Authorization': `bearer ${GITHUB_TOKEN}`,
      'Content-Type': 'application/json',
      'User-Agent': 'ryanchoi-dev',
    },
    body: JSON.stringify({
      query: `{
        user(login: "rmerk") {
          contributionsCollection {
            contributionCalendar {
              totalContributions
              weeks {
                contributionDays {
                  contributionCount
                  date
                }
              }
            }
          }
          repositories(first: 100, ownerAffiliations: OWNER, isFork: false) {
            nodes {
              languages(first: 5, orderBy: { field: SIZE, direction: DESC }) {
                edges {
                  size
                  node { name }
                }
              }
            }
          }
        }
      }`,
    }),
  });

  const user = gql?.data?.user;
  const calendar = user?.contributionsCollection?.contributionCalendar;
  const validWeeks = Array.isArray(calendar?.weeks) ? calendar.weeks.filter(isContributionWeek) : [];
  if (typeof calendar?.totalContributions === 'number' && validWeeks.length > 0) {
    totalContributions = calendar.totalContributions;
    contributionWeeks = validWeeks;
  }

  // Aggregate language bytes across all repos when GraphQL data is available.
  const langBytes = new Map<string, number>();
  const repoNodes = Array.isArray(user?.repositories?.nodes) ? user.repositories.nodes : [];
  for (const repo of repoNodes) {
    const languageEdges = Array.isArray(repo?.languages?.edges) ? repo.languages.edges : [];
    for (const edge of languageEdges.filter(isLanguageEdge)) {
      langBytes.set(edge.node.name, (langBytes.get(edge.node.name) || 0) + edge.size);
    }
  }
  if (langBytes.size > 0) {
    graphqlLanguages = [...langBytes.entries()]
      .sort((a, b) => b[1] - a[1])
      .map(([name]) => name);
  }
}

const languageColors: Record<string, string> = {
  TypeScript: 'bg-blue-400',
  JavaScript: 'bg-yellow-400',
  Vue: 'bg-emerald-400',
  Python: 'bg-blue-500',
  HTML: 'bg-orange-400',
  CSS: 'bg-purple-400',
  Shell: 'bg-green-400',
  Rust: 'bg-orange-600',
  Go: 'bg-cyan-400',
};

const eventDotColors: Record<string, string> = {
  'Pushed to': 'bg-green-400',
  'Created': 'bg-blue-400',
  'PR on': 'bg-purple-400',
  'Issue on': 'bg-yellow-400',
  'Starred': 'bg-amber-400',
  'Forked': 'bg-cyan-400',
};

// Map contribution count to intensity level (0-4)
function getContributionLevel(count: number): number {
  if (count === 0) return 0;
  if (count <= 3) return 1;
  if (count <= 6) return 2;
  if (count <= 9) return 3;
  return 4;
}

const contributionColors = [
  'bg-border/50',
  'bg-accent/20',
  'bg-accent/40',
  'bg-accent/70',
  'bg-accent',
];

// Frontend languages first, then backend, then everything else
const frontendLangs = new Set(['TypeScript', 'JavaScript', 'Vue', 'CSS', 'HTML', 'Astro', 'Svelte', 'SCSS', 'Sass', 'Less']);
const backendLangs = new Set(['Python', 'Ruby', 'PHP', 'Go', 'Rust', 'Java', 'Kotlin', 'Swift', 'C#', 'C++', 'C']);

function sortByCategory(langs: string[]): string[] {
  const frontend = langs.filter((l) => frontendLangs.has(l));
  const backend = langs.filter((l) => backendLangs.has(l));
  const other = langs.filter((l) => !frontendLangs.has(l) && !backendLangs.has(l));
  return [...frontend, ...backend, ...other];
}

function getRestLanguages(sourceRepos: GitHubRepo[]): string[] {
  const languageCounts = new Map<string, number>();
  for (const repo of sourceRepos) {
    if (repo.language) {
      languageCounts.set(repo.language, (languageCounts.get(repo.language) || 0) + 1);
    }
  }

  const languages = sortByCategory(
    [...languageCounts.entries()]
      .sort((a, b) => b[1] - a[1])
      .map(([name]) => name)
  );

  return languages.length > 0 ? languages : fallbackLanguages;
}

const languages = graphqlLanguages.length > 0 ? sortByCategory(graphqlLanguages) : getRestLanguages(repos);
---

<section class="py-16 sm:py-20">
  <!-- Section header -->
  <div class="mb-8 flex flex-col gap-4 sm:flex-row sm:items-end sm:justify-between">
    <div>
      <p class="mb-3 font-mono text-xs uppercase tracking-[0.2em] text-accent">Open Source</p>
      <h2 class="text-3xl font-semibold tracking-tight text-text sm:text-4xl">Recent engineering signal</h2>
      <p class="mt-3 max-w-2xl text-sm leading-7 text-muted">A lightweight snapshot of public repositories, language mix, and contribution activity.</p>
    </div>
    <a href={profile.html_url} target="_blank" rel="noopener noreferrer" class="text-sm font-semibold text-accent hover:underline focus-visible:ring-2 focus-visible:ring-accent">View profile &rarr;</a>
  </div>

  <!-- Profile header row -->
  <div class="mb-8 flex flex-col gap-4 rounded-3xl border border-border bg-surface/75 p-5 shadow-sm sm:flex-row sm:items-center sm:p-6">
    <div class="shrink-0 rounded-full border border-accent/25 bg-accent/10 p-1">
      <img
        src={profile.avatar_url}
        alt="Ryan Choi"
        width="56"
        height="56"
        class="rounded-full bg-surface"
        loading="lazy"
      />
    </div>
    <div class="min-w-0 flex-1">
      <p class="text-base font-semibold text-text">rmerk</p>
      {profile.bio && <p class="mt-1 truncate text-sm text-muted">{profile.bio}</p>}
    </div>
    <div class="grid grid-cols-2 gap-3 sm:flex sm:items-center">
      <div class="rounded-2xl border border-border bg-bg/40 px-4 py-3 text-center">
        <p class="font-mono text-lg font-semibold text-text">{profile.public_repos}</p>
        <p class="text-xs text-muted">Repos</p>
      </div>
      <div class="rounded-2xl border border-border bg-bg/40 px-4 py-3 text-center">
        <p class="font-mono text-lg font-semibold text-text">{profile.followers}</p>
        <p class="text-xs text-muted">Followers</p>
      </div>
    </div>
  </div>

  <!-- Contribution heatmap -->
  {contributionWeeks.length > 0 && (
    <div class="mb-8">
      <div class="mb-3 flex items-baseline justify-between">
        <h3 class="font-mono text-xs uppercase tracking-[0.18em] text-muted-soft">Contributions</h3>
        <span class="font-mono text-xs text-muted">{totalContributions} in the last year</span>
      </div>
      <div class="overflow-x-auto rounded-3xl border border-border bg-surface/75 p-4">
        <div class="flex gap-[3px]">
          {contributionWeeks.map((week) => (
            <div class="flex flex-col gap-[3px]">
              {week.contributionDays.map((day) => (
                <div
                  class={`w-[10px] h-[10px] rounded-sm ${contributionColors[getContributionLevel(day.contributionCount)]}`}
                  title={`${day.contributionCount} contributions on ${day.date}`}
                />
              ))}
            </div>
          ))}
        </div>
        <div class="flex items-center justify-end gap-1.5 mt-3">
          <span class="font-mono text-[10px] text-muted">Less</span>
          {contributionColors.map((color) => (
            <div class={`w-[10px] h-[10px] rounded-sm ${color}`} aria-hidden="true" />
          ))}
          <span class="font-mono text-[10px] text-muted">More</span>
        </div>
      </div>
    </div>
  )}

  <h3 class="mb-4 font-mono text-xs uppercase tracking-[0.18em] text-muted-soft">Popular Repositories</h3>

  <!-- Main content grid -->
  <div class="grid gap-6 lg:grid-cols-[1fr_300px]">
    <!-- Left: Popular Repositories -->
    <div>
      <div class="grid gap-4 sm:grid-cols-2">
        {repos.slice(0, 6).map((repo) => (
          <a
            href={repo.html_url}
            target="_blank"
            rel="noopener noreferrer"
            class="group block rounded-3xl border border-border bg-surface/75 p-5 transition-[border-color,transform,box-shadow] hover:-translate-y-0.5 hover:border-accent/35 hover:shadow-xl hover:shadow-black/10 focus-visible:ring-2 focus-visible:ring-accent"
          >
            <p class="truncate text-sm font-semibold text-text transition-colors group-hover:text-accent">{repo.name}</p>
            {repo.description && (
              <p class="mt-2 line-clamp-2 text-sm leading-6 text-muted">{repo.description}</p>
            )}
            <div class="mt-4 flex items-center gap-3">
              {repo.language && (
                <span class="flex items-center gap-1.5 text-xs text-muted">
                  <span class={`h-2 w-2 rounded-full ${languageColors[repo.language] || 'bg-gray-400'}`} aria-hidden="true"></span>
                  {repo.language}
                </span>
              )}
              {repo.stargazers_count > 0 && (
                <span class="flex items-center gap-1 text-xs text-muted">
                  <svg width="12" height="12" viewBox="0 0 16 16" fill="currentColor" aria-hidden="true">
                    <path d="M8 .25a.75.75 0 0 1 .673.418l1.882 3.815 4.21.612a.75.75 0 0 1 .416 1.279l-3.046 2.97.719 4.192a.75.75 0 0 1-1.088.791L8 12.347l-3.766 1.98a.75.75 0 0 1-1.088-.79l.72-4.194L.818 6.374a.75.75 0 0 1 .416-1.28l4.21-.611L7.327.668A.75.75 0 0 1 8 .25z" />
                  </svg>
                  {repo.stargazers_count}
                </span>
              )}
              {repo.forks_count > 0 && (
                <span class="flex items-center gap-1 text-xs text-muted">
                  <svg width="12" height="12" viewBox="0 0 16 16" fill="currentColor" aria-hidden="true">
                    <path d="M5 5.372v.878c0 .414.336.75.75.75h4.5a.75.75 0 0 0 .75-.75v-.878a2.25 2.25 0 1 0-1.5 0v.878H6.75v-.878a2.25 2.25 0 1 0-1.5 0ZM8 13.25a2.25 2.25 0 1 0 0-4.5 2.25 2.25 0 0 0 0 4.5Zm0-1.5a.75.75 0 1 1 0-1.5.75.75 0 0 1 0 1.5ZM5 3.25a.75.75 0 1 1 0-1.5.75.75 0 0 1 0 1.5Zm6.75-.75a.75.75 0 1 0-1.5 0 .75.75 0 0 0 1.5 0Z" />
                  </svg>
                  {repo.forks_count}
                </span>
              )}
            </div>
          </a>
        ))}
      </div>
    </div>

    <!-- Right column -->
    <div class="space-y-6">
      <!-- Languages card -->
      {languages.length > 0 && (
        <div class="rounded-3xl border border-border bg-surface/75 p-5">
          <h3 class="mb-3 font-mono text-xs uppercase tracking-[0.18em] text-muted-soft">Languages</h3>
          <div class="flex flex-wrap gap-2">
            {languages.map((lang) => (
              <span class="flex items-center gap-1.5 rounded-full border border-border bg-bg/40 px-2.5 py-1 font-mono text-xs text-text">
                <span class={`h-2 w-2 rounded-full ${languageColors[lang] || 'bg-gray-400'}`} aria-hidden="true"></span>
                {lang}
              </span>
            ))}
          </div>
        </div>
      )}

      <!-- Recent Activity card -->
      {recentActivity.length > 0 && (
        <div class="rounded-3xl border border-border bg-surface/75 p-5">
          <h3 class="mb-3 font-mono text-xs uppercase tracking-[0.18em] text-muted-soft">Recent Activity</h3>
          <div class="space-y-3">
            {recentActivity.map(({ repo, type, timeAgo }) => (
              <div class="flex items-start gap-2 text-xs leading-5">
                <span class={`mt-1.5 h-1.5 w-1.5 shrink-0 rounded-full ${eventDotColors[type] || 'bg-muted'}`} aria-hidden="true"></span>
                <div class="min-w-0 flex-1">
                  <span class="text-muted">{type}</span>{' '}
                  <span class="truncate font-medium text-text">{repo}</span>
                  <span class="text-muted/60 ml-1">{timeAgo}</span>
                </div>
              </div>
            ))}
          </div>
        </div>
      )}
    </div>
  </div>
</section>
