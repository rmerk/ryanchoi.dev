---
// src/components/GitHubSection.astro
// Design decision: present GitHub activity as an instrument panel — a ruled stat
// strip, one inset surface for the contribution grid, and everything else as
// aligned data rows.
//
// Hardline data rule: every number rendered here must be true, or the row that
// would carry it is dropped. There are no fallback constants. An earlier revision
// had five of them and they shipped as fact whenever the unauthenticated REST calls
// were rate-limited (60/hr per IP) — `30 repositories / 15 followers` against a
// truth of 46 / 11, two repo cards whose URLs 404, and the strings 'portfolio' and
// 'client work' sitting in a timestamp column. Dropping a row is honest; inventing
// one is not. This mirrors what src/data/build-info.ts already does with the title
// block: no value, no row.
//
// Everything except the activity feed now comes from one authenticated GraphQL
// request costing a single rate-limit point. That is both cheaper than the three
// unauthenticated REST calls it replaces and immune to the anonymous rate limit
// that was triggering the fallbacks in the first place.
//
// The 'Popular repositories' panel that used to sit between the contribution grid and
// the language list was removed rather than repaired. It sorted by `sort=stars`, which
// is not a valid sort for /users/{user}/repos, so GitHub silently ignored it and
// returned creation order — and there was nothing to rank in any case, since every one
// of the public repositories has zero stars. Four of the six cards it rendered were
// forks of other people's projects, presented as Ryan's own work. The honest
// replacement is a commit-volume ranking, which is a figure, not a fix.
import SectionHeader from '@/components/SectionHeader.astro';
import FigureBars from '@/components/FigureBars.astro';
import FigureStrip from '@/components/FigureStrip.astro';

interface Props {
  /**
   * This section's number in the homepage's running sequence. Passed in rather than
   * hardcoded so the numbering stays declared in index.astro, which owns the order
   * of the page's sections; hardcoding it here would split that across two files.
   */
  index: string;
}

const { index } = Astro.props;

const GITHUB_LOGIN = 'rmerk';
const GITHUB_PROFILE_URL = `https://github.com/${GITHUB_LOGIN}`;

interface GitHubEvent {
  type: string;
  repo: { name: string };
  created_at: string;
}

interface GitHubActivityItem {
  repo: string;
  type: string;
  timeAgo: string;
}

interface ContributionDay {
  contributionCount: number;
  date: string;
}

interface ContributionWeek {
  contributionDays: ContributionDay[];
}

interface LanguageTotal {
  name: string;
  bytes: number;
}

const restHeaders = { 'User-Agent': 'ryanchoi-dev' };

// DeleteEvent was missing, so a deleted branch rendered through the `.replace` path
// as the bare verb 'Delete' — 'Delete ryanchoi.dev' was present in the built HTML.
const eventTypeLabels: Record<string, string> = {
  PushEvent: 'Pushed to',
  CreateEvent: 'Created',
  DeleteEvent: 'Deleted in',
  PullRequestEvent: 'PR on',
  PullRequestReviewEvent: 'Reviewed on',
  IssuesEvent: 'Issue on',
  IssueCommentEvent: 'Commented on',
  WatchEvent: 'Starred',
  ForkEvent: 'Forked',
  ReleaseEvent: 'Released in',
};

async function fetchJson<T>(url: string, init?: RequestInit): Promise<T | null> {
  try {
    const response = await fetch(url, init);
    if (!response.ok) return null;
    return (await response.json()) as T;
  } catch {
    return null;
  }
}

function isRecord(value: unknown): value is Record<string, unknown> {
  return typeof value === 'object' && value !== null;
}

function isGitHubEvent(value: unknown): value is GitHubEvent {
  if (!isRecord(value) || !isRecord(value.repo)) return false;

  return (
    typeof value.type === 'string' &&
    typeof value.repo.name === 'string' &&
    typeof value.created_at === 'string'
  );
}

function isContributionDay(value: unknown): value is ContributionDay {
  return isRecord(value) && typeof value.contributionCount === 'number' && typeof value.date === 'string';
}

function isContributionWeek(value: unknown): value is ContributionWeek {
  return (
    isRecord(value) &&
    Array.isArray(value.contributionDays) &&
    value.contributionDays.every(isContributionDay)
  );
}

function isLanguageEdge(value: unknown): value is { size: number; node: { name: string } } {
  return (
    isRecord(value) &&
    typeof value.size === 'number' &&
    isRecord(value.node) &&
    typeof value.node.name === 'string'
  );
}

function getTimeAgo(createdAt: string, now: number): string {
  const diff = now - new Date(createdAt).getTime();
  const hours = Math.floor(diff / (1000 * 60 * 60));
  const days = Math.floor(hours / 24);

  if (days > 0) return `${days}d ago`;
  if (hours > 0) return `${hours}h ago`;
  return 'just now';
}

// The activity feed keeps the full owner/repo name. Stripping the owner with
// `.split('/').pop()` made a pull request on someone else's repository render
// identically to work on Ryan's own — a real case, since four of the six repos this
// section used to display were forks of other people's projects.
function resolveRecentActivity(events: unknown): GitHubActivityItem[] {
  const validEvents = Array.isArray(events) ? events.filter(isGitHubEvent) : [];
  const now = Date.now();

  return validEvents.slice(0, 5).map((event) => ({
    repo: event.repo.name,
    type: eventTypeLabels[event.type] || event.type.replace(/Event$/, ''),
    timeAgo: getTimeAgo(event.created_at, now),
  }));
}

const GITHUB_TOKEN = import.meta.env.GITHUB_TOKEN;

// Six years of annual totals, as aliased contributionsCollection fields. All six
// aliases resolve inside the same single-point request — the rate-limit cost of this
// whole query is 1, the same as it was when it fetched only the calendar.
//
// The window is the current year and the five before it, derived rather than pinned,
// so the figure rolls forward on its own. The current year is partial by definition
// and is labelled as such; an unlabelled final bar reads as a collapse every January.
const YEAR_SPAN = 6;
const currentYear = new Date().getUTCFullYear();
const years = Array.from({ length: YEAR_SPAN }, (_, i) => currentYear - (YEAR_SPAN - 1) + i);

const yearFields = years
  .map((year) => `y${year}: contributionsCollection(from: "${year}-01-01T00:00:00Z", to: "${year}-12-31T23:59:59Z") {
      restrictedContributionsCount
      contributionCalendar { totalContributions }
    }`)
  .join('\n    ');

const GRAPHQL_QUERY = `{
  user(login: "${GITHUB_LOGIN}") {
    url
    followers { totalCount }
    ${yearFields}
    contributionsCollection {
      restrictedContributionsCount
      commitContributionsByRepository(maxRepositories: 5) {
        repository {
          nameWithOwner
          isPrivate
          url
        }
        contributions { totalCount }
      }
      contributionCalendar {
        totalContributions
        weeks {
          contributionDays {
            contributionCount
            date
          }
        }
      }
    }
    repositories(first: 100, ownerAffiliations: OWNER, isFork: false) {
      totalCount
      nodes {
        languages(first: 10, orderBy: { field: SIZE, direction: DESC }) {
          edges {
            size
            node { name }
          }
        }
      }
    }
  }
}`;

interface YearTotal {
  year: number;
  total: number;
  restricted: number;
  open: number;
  partial: boolean;
}

interface RepoCommits {
  name: string;
  url: string;
  count: number;
}

let contributionWeeks: ContributionWeek[] = [];
let totalContributions = 0;
let privateContributions = 0;
let ownRepoCount = 0;
let followerCount = 0;
let profileUrl = GITHUB_PROFILE_URL;
let languageTotals: LanguageTotal[] = [];
let yearTotals: YearTotal[] = [];
let repoCommits: RepoCommits[] = [];

if (GITHUB_TOKEN) {
  const response = await fetch('https://api.github.com/graphql', {
    method: 'POST',
    headers: {
      'Authorization': `bearer ${GITHUB_TOKEN}`,
      'Content-Type': 'application/json',
      'User-Agent': 'ryanchoi-dev',
    },
    body: JSON.stringify({ query: GRAPHQL_QUERY }),
  }).catch(() => null);

  const payload = response?.ok ? await response.json().catch(() => null) : null;

  // GraphQL answers 200 with an `errors` array and nulled data on permission and
  // schema failures, so checking `response.ok` alone is structurally blind to them:
  // a scope-limited token nulls the entire `user` object and every figure below
  // silently disappears with nothing in the build log. Under the hardline rule a
  // wrong-but-plausible page is worse than no page, so this fails the build loudly
  // rather than degrading. A network failure still yields null and simply drops the
  // rows — absence is honest, invention is not.
  if (isRecord(payload) && Array.isArray(payload.errors) && payload.errors.length > 0) {
    const messages = payload.errors
      .map((error: unknown) => (isRecord(error) && typeof error.message === 'string' ? error.message : 'unknown error'))
      .join('; ');
    throw new Error(`GitHub GraphQL returned errors: ${messages}`);
  }

  const user = isRecord(payload) && isRecord(payload.data) ? payload.data.user : null;

  if (isRecord(user)) {
    if (typeof user.url === 'string') profileUrl = user.url;

    if (isRecord(user.followers) && typeof user.followers.totalCount === 'number') {
      followerCount = user.followers.totalCount;
    }

    const collection = isRecord(user.contributionsCollection) ? user.contributionsCollection : null;

    if (collection && typeof collection.restrictedContributionsCount === 'number') {
      privateContributions = collection.restrictedContributionsCount;
    }

    // Annual totals. A year is kept only when both its total and its restricted count
    // are present, because a bar drawn from a total with no split would silently
    // render entirely as public work — the flattering direction, and the one failure
    // this figure exists to prevent.
    yearTotals = years.flatMap((year) => {
      const entry = user[`y${year}`];
      if (!isRecord(entry)) return [];

      const calendar = isRecord(entry.contributionCalendar) ? entry.contributionCalendar : null;
      const total = calendar && typeof calendar.totalContributions === 'number' ? calendar.totalContributions : null;
      const restricted = typeof entry.restrictedContributionsCount === 'number' ? entry.restrictedContributionsCount : null;

      if (total === null || restricted === null) return [];

      return [{
        year,
        total,
        restricted,
        open: Math.max(0, total - restricted),
        partial: year === currentYear,
      }];
    });

    // Commit volume per repository — the honest answer to the question the removed
    // 'Popular repositories' panel was asking. Stars are zero across every repository,
    // so they rank nothing; commits have real variance. Private repositories are
    // dropped rather than redacted: a row reading 'private repository' is a shape
    // without a fact in it, and the count alone would still leak activity volume.
    const byRepo = collection && Array.isArray(collection.commitContributionsByRepository)
      ? collection.commitContributionsByRepository
      : [];

    repoCommits = byRepo.flatMap((entry) => {
      if (!isRecord(entry)) return [];
      const repository = isRecord(entry.repository) ? entry.repository : null;
      const contributions = isRecord(entry.contributions) ? entry.contributions : null;
      const count = contributions && typeof contributions.totalCount === 'number' ? contributions.totalCount : null;

      if (!repository || repository.isPrivate !== false || count === null || count <= 0) return [];
      if (typeof repository.nameWithOwner !== 'string' || typeof repository.url !== 'string') return [];

      return [{ name: repository.nameWithOwner, url: repository.url, count }];
    }).sort((a, b) => b.count - a.count);

    const calendar = collection && isRecord(collection.contributionCalendar) ? collection.contributionCalendar : null;
    const validWeeks = calendar && Array.isArray(calendar.weeks) ? calendar.weeks.filter(isContributionWeek) : [];

    if (calendar && typeof calendar.totalContributions === 'number' && validWeeks.length > 0) {
      totalContributions = calendar.totalContributions;
      contributionWeeks = validWeeks;
    }

    const repositories = isRecord(user.repositories) ? user.repositories : null;

    if (repositories && typeof repositories.totalCount === 'number') {
      ownRepoCount = repositories.totalCount;
    }

    // Language bytes, aggregated across owned non-fork repositories. The byte
    // magnitudes were already being fetched here and then discarded by a
    // `.map(([name]) => name)` that kept only the order of the names — and the order
    // was then reshuffled frontend-first by a `sortByCategory` helper, so the
    // rendered list contradicted the very magnitudes it was derived from. PHP is
    // the second-largest language by bytes and was displaying seventh. The sort is
    // now the true one and the sizes are kept.
    const langBytes = new Map<string, number>();
    const repoNodes = repositories && Array.isArray(repositories.nodes) ? repositories.nodes : [];

    for (const repo of repoNodes) {
      const languages = isRecord(repo) && isRecord(repo.languages) ? repo.languages : null;
      const edges = languages && Array.isArray(languages.edges) ? languages.edges : [];

      for (const edge of edges.filter(isLanguageEdge)) {
        langBytes.set(edge.node.name, (langBytes.get(edge.node.name) || 0) + edge.size);
      }
    }

    languageTotals = [...langBytes.entries()]
      .map(([name, bytes]) => ({ name, bytes }))
      .sort((a, b) => b.bytes - a.bytes);
  }
}

const eventsData = await fetchJson<unknown[]>(
  `https://api.github.com/users/${GITHUB_LOGIN}/events?per_page=5`,
  { headers: restHeaders }
);
const recentActivity = resolveRecentActivity(eventsData);

// The figure palette: one descending warm ramp, amber through to grey. No hue enters
// the system that was not already in it. `--color-code-type` was tried here and
// dropped — the sage green earns its place as syntax highlighting inside the resume
// editor, but in a composition strip on the homepage it reads as a different design
// language rather than another step in this one. `--color-code-string` stays, being a
// desaturated tan that sits inside the amber family.
//
// Segments are separated by a hairline in the page colour, so each fill only has to
// clear 3:1 against the background, not against its neighbour.
//
// These must stay literal strings. Tailwind scans source text for class names, so a
// fill assembled by interpolation is never generated and the segment renders bare.
const FIGURE_FILLS = [
  'bg-accent',
  'bg-accent-secondary',
  'bg-code-string',
  'bg-muted',
  'bg-muted-soft',
];
const FIGURE_TAIL_FILL = 'bg-border-strong';

// Five named languages plus a pooled tail. The full aggregate runs to 21 and falls
// away into things committed once years ago; naming all of them buries the four that
// account for three quarters of everything written. Five is also what the warm ramp
// can carry before two adjacent steps stop being tellable apart.
const LANGUAGE_SEGMENTS = 5;
const totalLanguageBytes = languageTotals.reduce((sum, entry) => sum + entry.bytes, 0);
const namedLanguages = languageTotals.slice(0, LANGUAGE_SEGMENTS);
const tailBytes = totalLanguageBytes - namedLanguages.reduce((sum, entry) => sum + entry.bytes, 0);
const tailCount = languageTotals.length - namedLanguages.length;

const share = (bytes: number) => (bytes / totalLanguageBytes) * 100;

const languageSegments = totalLanguageBytes > 0
  ? [
      ...namedLanguages.map((entry, i) => ({
        label: entry.name,
        pct: share(entry.bytes),
        fill: FIGURE_FILLS[i] ?? FIGURE_TAIL_FILL,
        value: `${share(entry.bytes).toFixed(1)}%`,
      })),
      ...(tailBytes > 0 && tailCount > 0
        ? [{
            label: `${tailCount} more`,
            pct: share(tailBytes),
            fill: FIGURE_TAIL_FILL,
            value: `${share(tailBytes).toFixed(1)}%`,
          }]
        : []),
    ]
  : [];

// Annual contributions, stacked public over private. Drawn on a linear scale even
// though two orders of magnitude separate the smallest year from the largest: the
// near-invisibility of the early bars is the finding, and a log scale would flatten
// the one thing this figure has to say. The segment min-width keeps a real year from
// rendering as nothing at all.
const maxYearTotal = Math.max(0, ...yearTotals.map((entry) => entry.total));
const yearRows = maxYearTotal > 0
  ? yearTotals.map((entry) => ({
      label: String(entry.year),
      note: entry.partial ? 'YTD' : undefined,
      value: entry.total.toLocaleString('en-US'),
      segments: [
        {
          pct: (entry.open / maxYearTotal) * 100,
          fill: 'bg-accent',
          label: `${entry.open.toLocaleString('en-US')} public`,
        },
        {
          pct: (entry.restricted / maxYearTotal) * 100,
          fill: 'bg-muted-soft',
          label: `${entry.restricted.toLocaleString('en-US')} private`,
        },
      ],
    }))
  : [];

// Every row in this figure is a repository Ryan committed to, so the owner prefix is
// noise on his own and signal on anyone else's. Stripping only his own keeps the
// attribution rule that the activity feed enforces — never present another person's
// repository as yours — while giving the narrow label column room to breathe.
const ownerPrefix = `${GITHUB_LOGIN}/`;
const displayRepoName = (nameWithOwner: string) =>
  nameWithOwner.startsWith(ownerPrefix) ? nameWithOwner.slice(ownerPrefix.length) : nameWithOwner;

const maxRepoCommits = Math.max(0, ...repoCommits.map((entry) => entry.count));
const repoRows = maxRepoCommits > 0
  ? repoCommits.map((entry) => ({
      label: displayRepoName(entry.name),
      href: entry.url,
      value: entry.count.toLocaleString('en-US'),
      segments: [{
        pct: (entry.count / maxRepoCommits) * 100,
        fill: 'bg-accent',
        label: `${entry.count.toLocaleString('en-US')} commits`,
      }],
    }))
  : [];

// Repositories is the count of repositories Ryan actually created. The REST
// `public_repos` field this replaces was 79, of which 33 are forks of other
// people's projects — publishing it overstated the body of work by 72%.
const stats: { key: string; value: string }[] = [
  ...(ownRepoCount > 0 ? [{ key: 'Repositories', value: String(ownRepoCount) }] : []),
  ...(followerCount > 0 ? [{ key: 'Followers', value: String(followerCount) }] : []),
  ...(totalContributions > 0
    ? [{ key: 'Contributions', value: totalContributions.toLocaleString('en-US') }]
    : []),
];

// Contribution intensity, bucketed by this account's own quantiles rather than
// GitHub's classic 0 / 1-3 / 4-6 / 7-9 / 10+ thresholds. Against a real distribution
// with a median of 6 and a maximum of 98, those fixed cutoffs put 144 of 262 active
// days — 55% of every coloured square — into the darkest bucket, so more than half
// the grid was one flat colour and the figure failed to represent its own data.
// Quantiles are computed from the response, so they cannot drift out of step with it.
function getQuantileThresholds(weeks: ContributionWeek[]): number[] {
  const active = weeks
    .flatMap((week) => week.contributionDays)
    .map((day) => day.contributionCount)
    .filter((count) => count > 0)
    .sort((a, b) => a - b);

  if (active.length === 0) return [1, 2, 3];

  // Three cut points split the non-zero days into four bands; level 0 stays reserved
  // for days with no activity at all.
  return [0.25, 0.5, 0.75].map((q) => active[Math.min(active.length - 1, Math.floor(active.length * q))]);
}

const contributionThresholds = getQuantileThresholds(contributionWeeks);

// The contribution total is dominated by work that is not public: of the last year's
// contributions, `restrictedContributionsCount` are commits to private repositories.
// Rendered bare under a heading about engineering activity, the total reads as
// open-source volume, which it is not — so the split is stated wherever the total is.
// The section eyebrow was 'Open source' for the same reason and is now 'GitHub'.
//
// Only non-zero when the token belongs to the profile being read. If it is ever
// rotated to another account the count collapses to zero and the clause drops rather
// than silently reframing 4,122 private contributions as public.
const contributionSummary = privateContributions > 0
  ? `${totalContributions.toLocaleString('en-US')} in the last year · ${privateContributions.toLocaleString('en-US')} private`
  : `${totalContributions.toLocaleString('en-US')} in the last year`;

function getContributionLevel(count: number): number {
  if (count === 0) return 0;
  if (count <= contributionThresholds[0]) return 1;
  if (count <= contributionThresholds[1]) return 2;
  if (count <= contributionThresholds[2]) return 3;
  return 4;
}

// Language and event-type dots used to be an arbitrary rainbow of Tailwind colors.
// In a single-accent system the label carries the meaning, so intensity is the only
// thing still expressed in color — here, on the contribution grid.
const contributionColors = [
  'bg-surface-raised',
  'bg-accent/25',
  'bg-accent/45',
  'bg-accent/70',
  'bg-accent',
];

// The column count follows the stat count so the closing hairline always spans the
// full row. A hardcoded sm:grid-cols-3 was wrong in both states: without
// GITHUB_TOKEN there are two stats in three columns and the rule stops at 2/3,
// and with it the mobile grid-cols-2 orphaned the third and stopped at 1/2.
// Base is an implicit grid-cols-1, so on mobile each stat is a full-width row.
//
// Keyed by stat count rather than interpolated into `sm:grid-cols-${n}`: Tailwind
// scans source text for class names, so an interpolated one is never generated.
const statColumnClass: Record<number, string> = {
  1: 'sm:grid-cols-1',
  2: 'sm:grid-cols-2',
  3: 'sm:grid-cols-3',
  4: 'sm:grid-cols-4',
};

// Fallback is one column, not three: with one column the closing hairline spans the
// full row at any stat count, so an unmapped count degrades to plain-but-correct
// rather than reinstating the short-rule defect this replaced.
const statGridClass = `mt-8 grid border-t border-border ${statColumnClass[stats.length] ?? 'sm:grid-cols-1'}`;

const hasContent = stats.length > 0
  || contributionWeeks.length > 0
  || languageSegments.length > 0
  || yearRows.length > 0
  || repoRows.length > 0
  || recentActivity.length > 0;

// The description names what is on the page, not what the component is capable of
// rendering. Without GITHUB_TOKEN the language list and contribution grid are both
// dropped and a fixed string promising them describes an empty section — the same
// class of error as the fallback constants, just one level up.
const described = [
  ...(languageSegments.length > 0 ? ['language mix'] : []),
  ...(yearRows.length > 0 || contributionWeeks.length > 0 ? ['contribution history'] : []),
  ...(repoRows.length > 0 ? ['commit volume by repository'] : []),
  ...(recentActivity.length > 0 ? ['recent events'] : []),
];
const description = described.length > 0
  ? `A build-time snapshot of ${new Intl.ListFormat('en-US').format(described)}, read from the GitHub API.`
  : 'A build-time snapshot read from the GitHub API.';
---

<!-- Asymmetric bottom padding is deliberate, not an oversight: Footer.astro's mt-24
     is shared by every page and is left alone, so this section's pb compensates to
     keep the final gap in rhythm with the 96/128 spacing between the others. -->
{hasContent && (
  <section class="pt-12 pb-0 sm:pt-16 sm:pb-8">
    <SectionHeader
      index={index}
      eyebrow="GitHub"
      title="Recent engineering signal"
      description={description}
      href={profileUrl}
      linkLabel="View profile"
    />

    <!-- Stat strip. The page's second typographic event: display-scale mono numerals,
         the move a datasheet actually makes. Far enough from the hero that the h1
         stays dominant, and the two are never co-visible. -->
    {stats.length > 0 && (
      <dl class={statGridClass}>
        {stats.map(({ key, value }) => (
          <div class="flex items-baseline justify-between gap-4 border-b border-border py-4 sm:block sm:py-5 sm:pr-6">
            <dt class="label text-muted-soft">{key}</dt>
            <dd class="font-mono text-display-2 font-medium tabular-nums text-text sm:mt-2">{value}</dd>
          </div>
        ))}
      </dl>
    )}

    {yearRows.length > 0 && (
      <div class="mt-10">
        <div class="flex items-baseline justify-between gap-4 border-t border-border pt-4">
          <h3 class="label text-muted-soft">Contributions by year</h3>
          <span class="label text-muted">Public / private</span>
        </div>
        <FigureBars
          class="mt-4"
          caption={`Contributions per year for the last ${yearRows.length} years, split into public and private work. Bars are proportional to the largest year.`}
          labelHeader="Year"
          valueHeader="Contributions"
          rows={yearRows}
        />
      </div>
    )}

    {contributionWeeks.length > 0 && (
      <div class="mt-10">
        <div class="flex items-baseline justify-between gap-4 border-t border-border pt-4">
          <h3 class="label text-muted-soft">Contributions</h3>
          <span class="label text-muted">{contributionSummary}</span>
        </div>
        <div class="mt-4 overflow-x-auto border border-border bg-surface p-4">
          <div
            class="flex gap-[3px]"
            role="img"
            aria-label={`Contribution activity: ${totalContributions} contributions in the last year`}
          >
            {contributionWeeks.map((week) => (
              <div class="flex flex-col gap-[3px]">
                {week.contributionDays.map((day) => (
                  <div
                    class={`h-[10px] w-[10px] rounded-sm ${contributionColors[getContributionLevel(day.contributionCount)]}`}
                    title={`${day.contributionCount} contributions on ${day.date}`}
                  />
                ))}
              </div>
            ))}
          </div>
          <div class="mt-3 flex items-center justify-end gap-1.5" aria-hidden="true">
            <span class="label text-muted-soft">Less</span>
            {contributionColors.map((color) => (
              <div class={`h-[10px] w-[10px] rounded-sm ${color}`} />
            ))}
            <span class="label text-muted-soft">More</span>
          </div>
        </div>
      </div>
    )}

    {languageSegments.length > 0 && (
      <div class="mt-10">
        <div class="flex items-baseline justify-between gap-4 border-t border-border pt-4">
          <h3 class="label text-muted-soft">Language composition</h3>
          <span class="label text-muted">{(totalLanguageBytes / 1_000_000).toFixed(1)} MB across {languageTotals.length} languages</span>
        </div>
        <FigureStrip
          class="mt-4"
          caption={`Language composition by bytes committed across ${ownRepoCount} owned repositories, measured by the GitHub API.`}
          segments={languageSegments}
        />
      </div>
    )}

    <div class="mt-10 grid gap-10 sm:grid-cols-2 sm:gap-x-10">
      {repoRows.length > 0 && (
        <div>
          <h3 class="label border-t border-border pt-4 text-muted-soft">Commits by repository</h3>
          <FigureBars
            class="mt-2"
            caption="Public repositories by commit count over the last year."
            labelHeader="Repository"
            valueHeader="Commits"
            rows={repoRows}
          />
        </div>
      )}

      {recentActivity.length > 0 && (
        <div>
          <h3 class="label border-t border-border pt-4 text-muted-soft">Recent activity</h3>
          <ul class="mt-2">
            {recentActivity.map(({ repo, type, timeAgo }) => (
              <li class="flex items-baseline justify-between gap-4 border-b border-border py-2.5">
                <span class="min-w-0 text-sm text-muted">
                  {type} <span class="font-medium text-text">{repo}</span>
                </span>
                <span class="label shrink-0 text-muted-soft">{timeAgo}</span>
              </li>
            ))}
          </ul>
        </div>
      )}
    </div>
  </section>
)}
