---
// src/components/GitHubSection.astro

interface GitHubProfile {
  avatar_url: string;
  public_repos: number;
  followers: number;
  bio: string | null;
  html_url: string;
}

interface GitHubEvent {
  type: string;
  repo: { name: string };
  created_at: string;
}

interface GitHubRepo {
  name: string;
  description: string | null;
  html_url: string;
  stargazers_count: number;
  forks_count: number;
  language: string | null;
}

let profile: GitHubProfile = {
  avatar_url: 'https://github.com/rmerk.png',
  public_repos: 30,
  followers: 15,
  bio: 'Senior Frontend Engineer',
  html_url: 'https://github.com/rmerk',
};

let recentActivity: { repo: string; type: string; timeAgo: string }[] = [];
let repos: GitHubRepo[] = [];

try {
  const [profileRes, eventsRes, reposRes] = await Promise.all([
    fetch('https://api.github.com/users/rmerk', {
      headers: { 'User-Agent': 'ryanchoi-dev' },
    }),
    fetch('https://api.github.com/users/rmerk/events?per_page=5', {
      headers: { 'User-Agent': 'ryanchoi-dev' },
    }),
    fetch('https://api.github.com/users/rmerk/repos?sort=stars&per_page=6&direction=desc', {
      headers: { 'User-Agent': 'ryanchoi-dev' },
    }),
  ]);

  if (profileRes.ok) {
    const data = await profileRes.json();
    profile = {
      avatar_url: data.avatar_url,
      public_repos: data.public_repos,
      followers: data.followers,
      bio: data.bio,
      html_url: data.html_url,
    };
  }

  if (eventsRes.ok) {
    const events: GitHubEvent[] = await eventsRes.json();
    const now = Date.now();

    recentActivity = events.slice(0, 5).map((event) => {
      const diff = now - new Date(event.created_at).getTime();
      const hours = Math.floor(diff / (1000 * 60 * 60));
      const days = Math.floor(hours / 24);
      const timeAgo = days > 0 ? `${days}d ago` : hours > 0 ? `${hours}h ago` : 'just now';

      const typeMap: Record<string, string> = {
        PushEvent: 'Pushed to',
        CreateEvent: 'Created',
        PullRequestEvent: 'PR on',
        IssuesEvent: 'Issue on',
        WatchEvent: 'Starred',
        ForkEvent: 'Forked',
      };

      return {
        repo: event.repo.name.split('/').pop() || event.repo.name,
        type: typeMap[event.type] || event.type.replace('Event', ''),
        timeAgo,
      };
    });
  }

  if (reposRes.ok) {
    repos = await reposRes.json();
  }
} catch {
  // Use hardcoded fallbacks
}

const languageColors: Record<string, string> = {
  TypeScript: 'bg-blue-400',
  JavaScript: 'bg-yellow-400',
  Vue: 'bg-emerald-400',
  Python: 'bg-blue-500',
  HTML: 'bg-orange-400',
  CSS: 'bg-purple-400',
  Shell: 'bg-green-400',
  Rust: 'bg-orange-600',
  Go: 'bg-cyan-400',
};

const eventDotColors: Record<string, string> = {
  'Pushed to': 'bg-green-400',
  'Created': 'bg-blue-400',
  'PR on': 'bg-purple-400',
  'Issue on': 'bg-yellow-400',
  'Starred': 'bg-amber-400',
  'Forked': 'bg-cyan-400',
};

// Aggregate languages from top repos
const languageCounts = new Map<string, number>();
for (const repo of repos) {
  if (repo.language) {
    languageCounts.set(repo.language, (languageCounts.get(repo.language) || 0) + 1);
  }
}
const languages = [...languageCounts.entries()]
  .sort((a, b) => b[1] - a[1])
  .map(([name]) => name);
---

<section class="py-16">
  <!-- Section header -->
  <div class="flex items-baseline justify-between mb-2">
    <div class="flex items-center gap-2">
      <span class="relative flex h-2 w-2">
        <span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-accent opacity-75"></span>
        <span class="relative inline-flex rounded-full h-2 w-2 bg-accent"></span>
      </span>
      <h2 class="font-mono text-sm text-muted uppercase tracking-widest">GitHub</h2>
    </div>
    <a href={profile.html_url} target="_blank" rel="noopener noreferrer" class="text-sm text-accent hover:underline font-mono">View profile &rarr;</a>
  </div>
  <p class="font-mono text-xs text-muted/50 mb-8">// open_source</p>

  <!-- Profile header row -->
  <div class="flex items-center gap-4 mb-8">
    <div class="rounded-full p-0.5 shrink-0" style="background: linear-gradient(135deg, var(--color-accent), var(--color-accent-secondary));">
      <img
        src={profile.avatar_url}
        alt="Ryan Choi"
        width="56"
        height="56"
        class="rounded-full bg-surface"
        loading="lazy"
      />
    </div>
    <div class="flex-1 min-w-0">
      <p class="font-mono text-sm text-text font-medium">rmerk</p>
      {profile.bio && <p class="text-xs text-muted truncate">{profile.bio}</p>}
    </div>
    <div class="hidden sm:flex items-center gap-4">
      <div class="text-center">
        <p class="font-mono text-lg text-text font-medium">{profile.public_repos}</p>
        <p class="text-xs text-muted">Repos</p>
      </div>
      <div class="text-center">
        <p class="font-mono text-lg text-text font-medium">{profile.followers}</p>
        <p class="text-xs text-muted">Followers</p>
      </div>
    </div>
  </div>

  <!-- Main content grid -->
  <div class="grid gap-6 lg:grid-cols-[1fr_280px]">
    <!-- Left: Popular Repositories -->
    <div>
      <h3 class="font-mono text-xs text-muted uppercase tracking-widest mb-4">Popular Repositories</h3>
      <div class="grid gap-4 sm:grid-cols-2">
        {repos.map((repo) => (
          <a
            href={repo.html_url}
            target="_blank"
            rel="noopener noreferrer"
            class="border border-border bg-surface rounded-lg p-4 hover:border-accent transition-colors group block"
          >
            <p class="font-mono text-sm text-text font-medium group-hover:text-accent transition-colors truncate">{repo.name}</p>
            {repo.description && (
              <p class="text-xs text-muted mt-1 line-clamp-2">{repo.description}</p>
            )}
            <div class="flex items-center gap-3 mt-3">
              {repo.language && (
                <span class="flex items-center gap-1 text-xs text-muted">
                  <span class={`w-2 h-2 rounded-full ${languageColors[repo.language] || 'bg-gray-400'}`} aria-hidden="true"></span>
                  {repo.language}
                </span>
              )}
              {repo.stargazers_count > 0 && (
                <span class="flex items-center gap-1 text-xs text-muted">
                  <svg width="12" height="12" viewBox="0 0 16 16" fill="currentColor" aria-hidden="true">
                    <path d="M8 .25a.75.75 0 0 1 .673.418l1.882 3.815 4.21.612a.75.75 0 0 1 .416 1.279l-3.046 2.97.719 4.192a.75.75 0 0 1-1.088.791L8 12.347l-3.766 1.98a.75.75 0 0 1-1.088-.79l.72-4.194L.818 6.374a.75.75 0 0 1 .416-1.28l4.21-.611L7.327.668A.75.75 0 0 1 8 .25z" />
                  </svg>
                  {repo.stargazers_count}
                </span>
              )}
              {repo.forks_count > 0 && (
                <span class="flex items-center gap-1 text-xs text-muted">
                  <svg width="12" height="12" viewBox="0 0 16 16" fill="currentColor" aria-hidden="true">
                    <path d="M5 5.372v.878c0 .414.336.75.75.75h4.5a.75.75 0 0 0 .75-.75v-.878a2.25 2.25 0 1 0-1.5 0v.878H6.75v-.878a2.25 2.25 0 1 0-1.5 0ZM8 13.25a2.25 2.25 0 1 0 0-4.5 2.25 2.25 0 0 0 0 4.5Zm0-1.5a.75.75 0 1 1 0-1.5.75.75 0 0 1 0 1.5ZM5 3.25a.75.75 0 1 1 0-1.5.75.75 0 0 1 0 1.5Zm6.75-.75a.75.75 0 1 0-1.5 0 .75.75 0 0 0 1.5 0Z" />
                  </svg>
                  {repo.forks_count}
                </span>
              )}
            </div>
          </a>
        ))}
      </div>
    </div>

    <!-- Right column -->
    <div class="space-y-6">
      <!-- Languages card -->
      {languages.length > 0 && (
        <div class="border border-border bg-surface rounded-lg p-4">
          <h3 class="font-mono text-xs text-muted uppercase tracking-widest mb-3">Languages</h3>
          <div class="flex flex-wrap gap-2">
            {languages.map((lang) => (
              <span class="flex items-center gap-1.5 text-xs text-muted bg-bg border border-border rounded-full px-2.5 py-1">
                <span class={`w-2 h-2 rounded-full ${languageColors[lang] || 'bg-gray-400'}`} aria-hidden="true"></span>
                {lang}
              </span>
            ))}
          </div>
        </div>
      )}

      <!-- Recent Activity card -->
      {recentActivity.length > 0 && (
        <div class="border border-border bg-surface rounded-lg p-4">
          <h3 class="font-mono text-xs text-muted uppercase tracking-widest mb-3">Recent Activity</h3>
          <div class="space-y-2.5">
            {recentActivity.map(({ repo, type, timeAgo }) => (
              <div class="flex items-start gap-2 text-xs">
                <span class={`w-1.5 h-1.5 rounded-full mt-1.5 shrink-0 ${eventDotColors[type] || 'bg-muted'}`} aria-hidden="true"></span>
                <div class="flex-1 min-w-0">
                  <span class="text-muted">{type}</span>{' '}
                  <span class="text-text font-medium truncate">{repo}</span>
                  <span class="text-muted/60 ml-1">{timeAgo}</span>
                </div>
              </div>
            ))}
          </div>
        </div>
      )}
    </div>
  </div>
</section>
