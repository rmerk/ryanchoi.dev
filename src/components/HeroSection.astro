---
// src/components/HeroSection.astro
// Design decision: open on a masthead, not a hero. A display statement over a
// ruled specification table — the block a datasheet leads with. The previous
// version paired this with a rotated glass panel showing invented product UI;
// that has been dropped rather than replaced, since nothing about it was real.
const specRows: { key: string; value: string; status?: boolean }[] = [
  { key: 'Role', value: 'Senior Frontend Engineer' },
  { key: 'Focus', value: 'Design systems · Frontend infrastructure · Accessibility' },
  { key: 'Stack', value: 'TypeScript · Vue · React · Astro · Tailwind CSS · Node.js' },
  { key: 'Domains', value: 'Fintech · SaaS' },
  { key: 'Status', value: 'Open to senior frontend roles', status: true },
];
---

<section class="mx-auto max-w-5xl px-5 pt-16 pb-20 sm:px-8 sm:pt-24 sm:pb-28">
  <h1 class="max-w-4xl text-display-1 font-semibold leading-[1.05] tracking-[-0.03em] text-text text-balance">
    Ryan Choi builds fast, accessible interfaces for product teams.
  </h1>

  <p class="mt-6 max-w-2xl text-base leading-8 text-muted sm:text-lg">
    Senior Frontend Engineer specializing in Vue, React, design systems, and frontend
    infrastructure for fintech and SaaS teams.
  </p>

  <!-- Specification table -->
  <dl class="mt-12 border-t border-border">
    {specRows.map(({ key, value, status }) => (
      <div class="grid gap-x-6 border-b border-border py-3 sm:grid-cols-[8rem_1fr] sm:items-baseline">
        <dt class="label pt-0.5 text-muted-soft">{key}</dt>
        <dd class="mt-1 text-sm leading-6 text-text sm:mt-0">
          {status && (
            <span class="mr-2 inline-block h-2 w-2 translate-y-[1px] bg-accent" aria-hidden="true"></span>
          )}
          {value}
        </dd>
      </div>
    ))}
  </dl>

  <!-- Actions -->
  <div class="mt-10 flex flex-col gap-3 sm:flex-row">
    <a
      href="/projects"
      class="inline-flex items-center justify-center gap-2 bg-accent px-6 py-3 text-sm font-semibold text-accent-ink transition-colors hover:bg-accent-secondary focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-accent focus-visible:ring-offset-2 focus-visible:ring-offset-bg"
    >
      View work
      <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" aria-hidden="true">
        <line x1="5" y1="12" x2="19" y2="12" /><polyline points="12 5 19 12 12 19" />
      </svg>
    </a>
    <a
      href="/resume"
      class="inline-flex items-center justify-center border border-border-strong px-6 py-3 text-sm font-semibold text-text transition-colors hover:border-accent hover:text-accent focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-accent focus-visible:ring-offset-2 focus-visible:ring-offset-bg"
    >
      Read resume
    </a>
  </div>
</section>
