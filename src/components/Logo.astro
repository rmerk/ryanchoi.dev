---
// src/components/Logo.astro
// Design decision: a monochrome rendering of the /logo.svg mark that inherits
// currentColor, so it sits inside the palette instead of importing the original's
// yellow-to-magenta gradient (the magenta stop clashes badly with amber).
// public/logo.svg is left untouched — swap this component back for an <img> to
// restore the gradient mark.
interface Props {
  class?: string;
}

const { class: className } = Astro.props;
---

<svg
  viewBox="0 0 190.15 108.83"
  fill="currentColor"
  class={className}
  role="img"
  aria-hidden="true"
  focusable="false"
>
