---
// src/components/PostRow.astro
// Design decision: an index entry with the date in a fixed mono gutter, so dates
// align down the page as a column. Only the title is a link — the row used to wrap
// date, title, and chevron in one anchor, which made the accessible name verbose.
// Tags were accepted but never rendered; they now carry real metadata.
interface Props {
  title: string;
  date: Date;
  slug: string;
  tags: string[];
}

const { title, date, slug, tags } = Astro.props;

const formattedDate = date.toLocaleDateString('en-US', {
  year: 'numeric',
  month: 'short',
  day: '2-digit',
});
---

<article class="group border-b border-border">
  <div class="grid gap-x-8 gap-y-2 py-6 sm:grid-cols-[9rem_1fr] sm:items-baseline">
    <time
      class="label text-muted-soft transition-colors group-hover:text-accent"
      datetime={date.toISOString()}
    >
      {formattedDate}
    </time>

    <div class="min-w-0">
      <h3 class="text-base font-medium text-text sm:text-lg">
        <a
          href={`/blog/${slug}`}
          class="rule-link transition-colors hover:text-accent focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-accent"
        >
          {title}
        </a>
      </h3>

      {tags.length > 0 && (
        <ul class="mt-2.5 flex flex-wrap gap-x-2 gap-y-1">
          {tags.map((tag, i) => (
            <li class="label text-muted-soft">
              {tag}
              {i < tags.length - 1 && <span class="ml-2 text-border-strong" aria-hidden="true">/</span>}
            </li>
          ))}
        </ul>
      )}
    </div>
  </div>
</article>
