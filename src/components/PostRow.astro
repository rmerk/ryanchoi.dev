---
// src/components/PostRow.astro
interface Props {
  title: string;
  date: Date;
  slug: string;
  tags: string[];
}

// tags is accepted for future use (e.g. tag filtering) but not rendered in the row view
const { title, date, slug, tags: _tags } = Astro.props;

const formattedDate = date.toLocaleDateString('en-US', {
  year: 'numeric',
  month: 'short',
  day: 'numeric',
});
---

<article class="flex items-baseline gap-6 py-4 border-b border-border group">
  <time class="font-mono text-sm text-muted shrink-0 w-28">{formattedDate}</time>
  <a href={`/blog/${slug}`} class="text-text hover:text-accent transition-colors flex-1">
    {title}
  </a>
</article>
