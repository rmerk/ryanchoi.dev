---
// src/components/PostRow.astro
// Design decision: an index entry with the date in a fixed mono gutter, so dates
// align down the page as a column. Only the title is a link — the row used to wrap
// date, title, and chevron in one anchor, which made the accessible name verbose.
// Tags were accepted but never rendered; they now carry real metadata.
import MetaList from '@/components/MetaList.astro';

interface Props {
  title: string;
  date: Date;
  slug: string;
  tags: string[];
  /** 2 on the blog index where posts are the top-level content, 3 under a section h2. */
  headingLevel?: 2 | 3;
  /** Homepage only: pull the date gutter onto the page's datum margin at lg. */
  datum?: boolean;
}

const { title, date, slug, tags, headingLevel = 3, datum = false } = Astro.props;

const Heading = `h${headingLevel}` as const;

// Both branches are literal strings so Tailwind's @source scan sees them. The false
// branch is character-for-character the attribute it replaces, which is what keeps
// /blog unchanged.
const rowClass = datum
  ? 'grid gap-x-8 gap-y-2 py-6 sm:grid-cols-[9rem_1fr] sm:items-baseline lg:datum-row lg:gap-x-6'
  : 'grid gap-x-8 gap-y-2 py-6 sm:grid-cols-[9rem_1fr] sm:items-baseline';

const formattedDate = date.toLocaleDateString('en-US', {
  year: 'numeric',
  month: 'short',
  day: '2-digit',
});
---

<article class="group border-b border-border">
  <div class={rowClass}>
    <time
      class="label text-muted-soft transition-colors group-hover:text-accent"
      datetime={date.toISOString()}
    >
      {formattedDate}
    </time>

    <div class="min-w-0">
      <Heading class="text-base font-medium text-text sm:text-lg">
        <a
          href={`/blog/${slug}`}
          class="rule-link transition-colors hover:text-accent"
        >
          {title}
        </a>
      </Heading>

      <MetaList items={tags} class="mt-2.5" />
    </div>
  </div>
</article>
