---
// src/components/PostRow.astro
// Design decision: treat writing rows as editorial index items with clear dates,
// generous touch targets, and subtle interaction instead of dense list styling.
interface Props {
  title: string;
  date: Date;
  slug: string;
  tags: string[];
}

// tags is accepted for future use (e.g. tag filtering) but not rendered in the row view
const { title, date, slug, tags: _tags } = Astro.props;

const formattedDate = date.toLocaleDateString('en-US', {
  year: 'numeric',
  month: 'short',
  day: 'numeric',
});
---

<article class="group">
  <a href={`/blog/${slug}`} class="grid gap-3 rounded-2xl border border-transparent px-4 py-5 transition-colors hover:border-border hover:bg-surface/70 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-accent sm:grid-cols-[9rem_1fr_auto] sm:items-center">
    <time
      class="font-mono text-xs uppercase tracking-[0.14em] text-muted-soft transition-colors group-hover:text-muted"
      datetime={date.toISOString()}
    >
      {formattedDate}
    </time>
    <span class="text-base font-medium text-text transition-colors group-hover:text-accent">{title}</span>
    <svg
      width="16"
      height="16"
      viewBox="0 0 24 24"
      fill="none"
      stroke="currentColor"
      stroke-width="2"
      class="hidden shrink-0 text-accent opacity-0 transition-opacity group-hover:opacity-100 sm:block"
      aria-hidden="true"
    >
      <line x1="5" y1="12" x2="19" y2="12"/>
      <polyline points="12 5 19 12 12 19"/>
    </svg>
  </a>
</article>
