---
// src/components/ProjectCard.astro
interface Props {
  title: string;
  description: string;
  tech: string[];
  url?: string;
  github?: string;
}

const { title, description, tech, url, github } = Astro.props;
---

<article class="group border border-border bg-surface rounded-lg p-6 transition-all duration-200 hover:border-accent hover:-translate-y-0.5">
  <div class="flex items-start justify-between gap-4 mb-3">
    <h2 class="font-semibold text-text text-lg">{title}</h2>
    <div class="flex gap-3 shrink-0">
      {github && (
        <a href={github} target="_blank" rel="noopener noreferrer" aria-label={`GitHub repository for ${title}`} class="text-muted hover:text-accent transition-colors text-sm font-mono">
          GitHub
        </a>
      )}
      {url && (
        <a href={url} target="_blank" rel="noopener noreferrer" aria-label={`Live site for ${title}`} class="text-muted hover:text-accent transition-colors text-sm font-mono">
          Live
        </a>
      )}
    </div>
  </div>

  <p class="text-muted text-sm leading-relaxed mb-4">{description}</p>

  <div class="flex flex-wrap gap-2">
    {tech.map((t) => (
      <span class="font-mono text-xs text-accent border border-accent/30 rounded px-2 py-0.5">
        {t}
      </span>
    ))}
  </div>
</article>
