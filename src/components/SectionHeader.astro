---
// src/components/SectionHeader.astro
// Design decision: every section opens the same way — a hairline rule, a numbered
// mono index on the left, an optional jump link on the right, then the heading.
// The numbering is what gives the page its specification-document read.
interface Props {
  index: string;
  eyebrow: string;
  title: string;
  description?: string;
  href?: string;
  linkLabel?: string;
}

const { index, eyebrow, title, description, href, linkLabel } = Astro.props;
---

<header class="border-t border-border pt-4">
  <div class="flex items-baseline justify-between gap-4">
    <p class="label text-muted-soft">
      <span class="text-accent">{index}</span>
      <span class="mx-1.5" aria-hidden="true">/</span>
      {eyebrow}
    </p>
    {href && linkLabel && (
      <a
        href={href}
        class="rule-link label shrink-0 text-muted transition-colors hover:text-accent"
      >
        {linkLabel} &rarr;
      </a>
    )}
  </div>

  <h2 class="mt-6 max-w-3xl text-display-3 font-semibold leading-tight tracking-tight text-text text-balance">
    {title}
  </h2>

  {description && (
    <p class="mt-3 max-w-2xl text-sm leading-7 text-muted">{description}</p>
  )}
</header>
