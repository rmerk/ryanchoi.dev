---
// src/layouts/BaseLayout.astro
// Design decision: keep the document shell lean and specification-like, with theme
// colors and typography loaded globally while preserving skip navigation and theme
// restore. Fonts load with display=optional so they cannot shift layout.
import { ClientRouter } from 'astro:transitions';
import Nav from '@/components/Nav.astro';
import Footer from '@/components/Footer.astro';
import '@/styles/global.css';

interface Props {
  title: string;
  description?: string;
  image?: string;
}

const {
  title,
  description = 'Ryan Choi is a senior frontend engineer building fast, accessible interfaces for product teams.',
  image = '/social-card.png',
} = Astro.props;

const site = Astro.site ?? new URL('https://ryanchoi.dev');
const canonicalUrl = new URL(Astro.url.pathname, site);
const imageUrl = new URL(image, site);
const pageTitle = title === 'Home' ? 'Ryan Choi | Senior Frontend Engineer' : `${title} | Ryan Choi`;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <!-- Inline: runs synchronously before body renders to prevent FOUC on theme restore -->
    <script is:inline>
      (function () {
        function applyTheme() {
          let stored = null;
          try { stored = localStorage.getItem('theme'); } catch (_) {}
          const valid = ['light', 'dark'];
          const preference = valid.includes(stored) ? stored : null;
          const prefersDark = window.matchMedia('(prefers-color-scheme: dark)').matches;
          const theme = preference ?? (prefersDark ? 'dark' : 'light');
          document.documentElement.classList.toggle('light', theme === 'light');
        }
        applyTheme();
        document.addEventListener('astro:after-swap', applyTheme);
      })();
    </script>
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalUrl.href} />
    <meta name="theme-color" content="#14110f" media="(prefers-color-scheme: dark)" />
    <meta name="theme-color" content="#f5f1e8" media="(prefers-color-scheme: light)" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Ryan Choi" />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalUrl.href} />
    <meta property="og:image" content={imageUrl.href} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="Ryan Choi - Senior Frontend Engineer" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={imageUrl.href} />
    <title>{pageTitle}</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <!-- display=optional, not swap: the browser either has the face ready at first
         paint or renders the fallback for that load and never swaps, so webfonts
         cannot introduce CLS. Subsequent visits paint Archivo from cache. -->
    <link href="https://fonts.googleapis.com/css2?family=Archivo:wght@400;500;600;700&family=IBM+Plex+Mono:wght@400;500;600&display=optional" rel="stylesheet" />
    <ClientRouter />
  </head>
  <body class="min-h-screen flex flex-col">
    <a href="#main-content" class="sr-only focus:not-sr-only focus:fixed focus:top-3 focus:left-3 focus:z-[100] focus:bg-accent focus:text-accent-ink focus:px-4 focus:py-2 focus:text-sm focus:font-medium">
      Skip to content
    </a>
    <Nav />
    <main id="main-content" class="flex-1">
      <slot />
    </main>
    <Footer />
  </body>
</html>
