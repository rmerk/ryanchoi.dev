---
// src/layouts/PostLayout.astro
// Design decision: a reading document — narrow measure, a ruled masthead carrying
// date and tags as one metadata line, and prose colored entirely from tokens so
// light mode is a first-class rendering rather than an inverted dark one.
import BaseLayout from '@/layouts/BaseLayout.astro';

interface Props {
  title: string;
  date: Date;
  tags: string[];
  description?: string;
}

const { title, date, tags, description } = Astro.props;

const formattedDate = date.toLocaleDateString('en-US', {
  year: 'numeric',
  month: 'long',
  day: 'numeric',
});
---

<BaseLayout title={title} description={description ?? `Read ${title} by Ryan Choi.`}>
  <div class="mx-auto max-w-3xl px-5 py-16 sm:px-8 sm:py-24">
    <a
      href="/blog"
      class="rule-link label text-muted transition-colors hover:text-accent focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-accent"
    >
      &larr; Back to writing
    </a>

    <header class="mt-10 border-t border-border pt-6">
      <div class="label flex flex-wrap items-baseline gap-x-2 gap-y-1 text-muted-soft">
        <time datetime={date.toISOString()}>{formattedDate}</time>
        {tags.map((tag) => (
          <>
            <span class="text-border-strong" aria-hidden="true">/</span>
            <span class="text-accent">{tag}</span>
          </>
        ))}
      </div>

      <h1 class="mt-6 text-display-2 font-semibold leading-[1.1] tracking-[-0.025em] text-text text-balance">
        {title}
      </h1>
    </header>

    <article class="prose prose-sm mt-12 max-w-none border-t border-border pt-12
      prose-headings:font-semibold prose-headings:tracking-tight
      prose-p:leading-8
      prose-li:leading-8
      prose-a:font-medium
      prose-pre:text-sm">
      <slot />
    </article>
  </div>
</BaseLayout>
