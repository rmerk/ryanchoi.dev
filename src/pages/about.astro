---
// src/pages/about.astro
// Design decision: frame the about page as a concise editorial profile with a
// polished contact card and the same quiet surface system as the homepage.
import BaseLayout from '@/layouts/BaseLayout.astro';
---

<BaseLayout title="About" description="Learn about Ryan Choi, a senior frontend engineer focused on durable product interfaces, design systems, and developer workflows.">
  <div class="mx-auto max-w-5xl px-5 py-16 sm:px-6 sm:py-24">
    <div class="mb-12 max-w-3xl">
      <p class="mb-3 font-mono text-xs uppercase tracking-[0.2em] text-accent">About</p>
      <h1 class="text-4xl font-semibold tracking-tight text-text text-balance sm:text-5xl">Frontend engineer focused on durable product interfaces.</h1>
      <p class="mt-5 text-lg leading-8 text-muted">I care about the details that make teams faster and interfaces easier to trust.</p>
    </div>

    <div class="grid gap-8 md:grid-cols-[1fr_20rem]">
      <!-- Bio -->
      <div class="rounded-3xl border border-border bg-surface/65 p-6 text-muted shadow-sm sm:p-8">
        <div class="space-y-6 leading-8">
          <p>
            I'm a Senior Frontend Engineer with 8+ years of experience in fintech and SaaS.
            I specialize in Vue and React, building reusable component systems and improving
            developer workflows.
          </p>
          <p>
            Currently at <a href="https://www.equifax.com" target="_blank" rel="noopener noreferrer" class="text-accent hover:underline">Equifax</a>,
            where I work on frontend infrastructure and branded Help Center tooling.
          </p>
          <p>
            Outside of work I'm interested in developer tooling, AI-assisted workflows,
            and building things that scratch my own itch.
          </p>
        </div>
      </div>

      <!-- Contact card -->
      <div class="h-fit rounded-3xl border border-border bg-surface/80 p-6 shadow-sm">
        <h2 class="mb-5 font-mono text-xs uppercase tracking-[0.18em] text-muted-soft">Contact</h2>

        <div class="space-y-3">
          <a href="mailto:ryan@ryanchoi.dev" class="group flex items-center gap-3 rounded-2xl border border-transparent px-3 py-2 text-sm text-text transition-colors hover:border-border hover:bg-bg/40 hover:text-accent focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-accent">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="text-muted group-hover:text-accent transition-colors shrink-0" aria-hidden="true">
              <path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"/>
              <polyline points="22,6 12,13 2,6"/>
            </svg>
            ryan@ryanchoi.dev
          </a>

          <a href="https://github.com/rmerk" target="_blank" rel="noopener noreferrer" class="group flex items-center gap-3 rounded-2xl border border-transparent px-3 py-2 text-sm text-text transition-colors hover:border-border hover:bg-bg/40 hover:text-accent focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-accent">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor" class="text-muted group-hover:text-accent transition-colors shrink-0" aria-hidden="true">
              <path d="M12 2C6.477 2 2 6.477 2 12c0 4.42 2.865 8.17 6.839 9.49.5.092.682-.217.682-.482 0-.237-.008-.866-.013-1.7-2.782.604-3.369-1.34-3.369-1.34-.454-1.156-1.11-1.464-1.11-1.464-.908-.62.069-.608.069-.608 1.003.07 1.531 1.03 1.531 1.03.892 1.529 2.341 1.087 2.91.832.092-.647.35-1.088.636-1.338-2.22-.253-4.555-1.11-4.555-4.943 0-1.091.39-1.984 1.029-2.683-.103-.253-.446-1.27.098-2.647 0 0 .84-.269 2.75 1.025A9.578 9.578 0 0112 6.836c.85.004 1.705.114 2.504.336 1.909-1.294 2.747-1.025 2.747-1.025.546 1.377.203 2.394.1 2.647.64.699 1.028 1.592 1.028 2.683 0 3.842-2.339 4.687-4.566 4.935.359.309.678.919.678 1.852 0 1.336-.012 2.415-.012 2.743 0 .267.18.578.688.48C19.138 20.167 22 16.418 22 12c0-5.523-4.477-10-10-10z"/>
            </svg>
            github.com/rmerk
          </a>

          <a href="https://www.linkedin.com/in/ryanchoimn/" target="_blank" rel="noopener noreferrer" class="group flex items-center gap-3 rounded-2xl border border-transparent px-3 py-2 text-sm text-text transition-colors hover:border-border hover:bg-bg/40 hover:text-accent focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-accent">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor" class="text-muted group-hover:text-accent transition-colors shrink-0" aria-hidden="true">
              <path d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433a2.062 2.062 0 01-2.063-2.065 2.064 2.064 0 112.063 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z"/>
            </svg>
            linkedin.com/in/ryanchoimn
          </a>
        </div>
      </div>
    </div>
  </div>
</BaseLayout>
