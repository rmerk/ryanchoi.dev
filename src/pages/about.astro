---
// src/pages/about.astro
// Design decision: a two-part document — prose at a comfortable measure, then a
// ruled contact table matching the homepage masthead. The bio and contact panels
// were previously two rounded cards side by side; the rules carry that job now.
import BaseLayout from '@/layouts/BaseLayout.astro';
import PageHeader from '@/components/PageHeader.astro';

const contactRows: { key: string; value: string; href: string; external: boolean }[] = [
  { key: 'Email', value: 'ryan@ryanchoi.dev', href: 'mailto:ryan@ryanchoi.dev', external: false },
  { key: 'GitHub', value: 'github.com/rmerk', href: 'https://github.com/rmerk', external: true },
  { key: 'LinkedIn', value: 'linkedin.com/in/ryanchoimn', href: 'https://www.linkedin.com/in/ryanchoimn/', external: true },
];
---

<BaseLayout title="About" description="Learn about Ryan Choi, a senior frontend engineer focused on durable product interfaces, design systems, and developer workflows.">
  <div class="mx-auto max-w-5xl px-5 py-16 sm:px-8 sm:py-24">
    <PageHeader
      eyebrow="About"
      title="Frontend engineer focused on durable product interfaces."
      lede="I care about the details that make teams faster and interfaces easier to trust."
    />

    <div class="mt-14 grid gap-x-12 gap-y-14 lg:grid-cols-[minmax(0,1fr)_20rem]">
      <!-- Bio -->
      <div class="max-w-2xl space-y-6 text-base leading-8 text-muted">
        <p>
          I'm a Senior Frontend Engineer with 8+ years of experience in fintech and SaaS.
          I specialize in Vue and React, building reusable component systems and improving
          developer workflows.
        </p>
        <p>
          Currently at <a href="https://www.equifax.com" target="_blank" rel="noopener noreferrer" class="rule-link text-accent">Equifax</a>,
          where I work on frontend infrastructure and branded Help Center tooling.
        </p>
        <p>
          Outside of work I'm interested in developer tooling, AI-assisted workflows,
          and building things that scratch my own itch.
        </p>
      </div>

      <!-- Contact -->
      <div class="h-fit">
        <h2 class="label border-t border-border pt-4 text-muted-soft">Contact</h2>
        <dl class="mt-4 border-t border-border">
          {contactRows.map(({ key, value, href, external }) => (
            <div class="grid gap-x-4 border-b border-border py-3 sm:grid-cols-[5.5rem_1fr] sm:items-baseline">
              <dt class="label pt-0.5 text-muted-soft">{key}</dt>
              <dd class="mt-1 min-w-0 sm:mt-0">
                <a
                  href={href}
                  target={external ? '_blank' : undefined}
                  rel={external ? 'noopener noreferrer' : undefined}
                  class="rule-link break-words text-sm text-text transition-colors hover:text-accent"
                >
                  {value}
                </a>
              </dd>
            </div>
          ))}
        </dl>
      </div>
    </div>
  </div>
</BaseLayout>
