---
// src/pages/blog/index.astro
// Design decision: an archive index — dates aligned in a mono gutter down the page,
// entries separated by hairlines rather than boxed in a panel.
import { getCollection } from 'astro:content';
import BaseLayout from '@/layouts/BaseLayout.astro';
import PageHeader from '@/components/PageHeader.astro';
import PostRow from '@/components/PostRow.astro';

const posts = (await getCollection('blog', ({ data }) => !data.draft))
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());
---

<BaseLayout title="Blog" description="Writing from Ryan Choi on frontend engineering, software craft, reliable interfaces, and calmer developer workflows.">
  <div class="mx-auto max-w-5xl px-5 py-16 sm:px-8 sm:py-24">
    <PageHeader
      eyebrow="Writing"
      title="Notes on frontend engineering and software craft."
      lede="Thoughts on building reliable interfaces, better tooling, and calmer developer workflows."
    />

    <div class="mt-12">
      <p class="label border-t border-border py-3 text-muted-soft">
        {posts.length} {posts.length === 1 ? 'post' : 'posts'}
      </p>

      <div class="border-t border-border">
        {posts.map((post) => (
          <PostRow
            headingLevel={2}
            title={post.data.title}
            date={post.data.date}
            slug={post.id.replace(/\.md$/, '')}
            tags={post.data.tags}
          />
        ))}
      </div>
    </div>
  </div>
</BaseLayout>
