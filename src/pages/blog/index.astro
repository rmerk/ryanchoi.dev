---
// src/pages/blog/index.astro
// Design decision: make the writing index feel like a clean editorial archive
// with a strong intro and roomy, mobile-friendly post rows.
import { getCollection } from 'astro:content';
import BaseLayout from '@/layouts/BaseLayout.astro';
import PostRow from '@/components/PostRow.astro';

const posts = (await getCollection('blog', ({ data }) => !data.draft))
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());
---

<BaseLayout title="Blog" description="Writing from Ryan Choi on frontend engineering, software craft, reliable interfaces, and calmer developer workflows.">
  <div class="mx-auto max-w-4xl px-5 py-16 sm:px-6 sm:py-24">
    <div class="mb-12">
      <p class="mb-3 font-mono text-xs uppercase tracking-[0.2em] text-accent">Writing</p>
      <h1 class="text-4xl font-semibold tracking-tight text-text text-balance sm:text-5xl">Notes on frontend engineering and software craft.</h1>
      <p class="mt-5 max-w-2xl text-lg leading-8 text-muted">Thoughts on building reliable interfaces, better tooling, and calmer developer workflows.</p>
    </div>

    <div class="rounded-3xl border border-border bg-surface/55 p-2">
      {posts.map((post) => (
        <PostRow
          title={post.data.title}
          date={post.data.date}
          slug={post.id.replace(/\.md$/, '')}
          tags={post.data.tags}
        />
      ))}
    </div>
  </div>
</BaseLayout>
