---
// src/pages/index.astro
import { getCollection } from 'astro:content';
import BaseLayout from '@/layouts/BaseLayout.astro';
import ProjectCard from '@/components/ProjectCard.astro';
import PostRow from '@/components/PostRow.astro';

const featuredProjects = (await getCollection('projects', ({ data }) => data.featured))
  .sort((a, b) => a.data.order - b.data.order)
  .slice(0, 3);

const latestPosts = (await getCollection('blog', ({ data }) => !data.draft))
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf())
  .slice(0, 3);
---

<BaseLayout title="Home" description="Ryan Choi — Senior Frontend Engineer">
  <div class="max-w-4xl mx-auto px-6">

    <!-- Hero -->
    <section class="py-24 md:py-32">
      <p class="font-mono text-sm text-muted mb-4">Hello, I'm</p>
      <h1 class="text-5xl md:text-6xl font-bold text-text mb-6 leading-tight">
        Ryan Choi
      </h1>
      <p class="text-xl text-muted max-w-xl leading-relaxed mb-10">
        Senior Frontend Engineer. I build fast, accessible web experiences
        with Vue, React, and modern tooling.
      </p>
      <div class="flex flex-wrap gap-4">
        <a href="/projects" class="inline-flex items-center gap-2 bg-accent text-white text-sm font-medium px-5 py-2.5 rounded-md hover:bg-accent/90 transition-colors">
          View Work
        </a>
        <a href="/resume" class="inline-flex items-center gap-2 border border-border text-text text-sm font-medium px-5 py-2.5 rounded-md hover:border-accent transition-colors">
          Resume
        </a>
      </div>
    </section>

    <!-- Featured Projects -->
    {featuredProjects.length > 0 && (
      <section class="py-16 border-t border-border">
        <div class="flex items-baseline justify-between mb-8">
          <h2 class="font-mono text-sm text-muted uppercase tracking-widest">Featured Work</h2>
          <a href="/projects" class="text-sm text-accent hover:underline font-mono">All projects &rarr;</a>
        </div>
        <div class="grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
          {featuredProjects.map((project) => (
            <ProjectCard
              title={project.data.title}
              description={project.data.description}
              tech={project.data.tech}
              url={project.data.url}
              github={project.data.github}
            />
          ))}
        </div>
      </section>
    )}

    <!-- Latest Writing -->
    {latestPosts.length > 0 && (
      <section class="py-16 border-t border-border">
        <div class="flex items-baseline justify-between mb-8">
          <h2 class="font-mono text-sm text-muted uppercase tracking-widest">Latest Writing</h2>
          <a href="/blog" class="text-sm text-accent hover:underline font-mono">All posts &rarr;</a>
        </div>
        <div>
          {latestPosts.map((post) => (
            <PostRow
              title={post.data.title}
              date={post.data.date}
              slug={post.id.replace(/\.md$/, '')}
              tags={post.data.tags}
            />
          ))}
        </div>
      </section>
    )}

  </div>
</BaseLayout>
