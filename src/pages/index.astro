---
// src/pages/index.astro
// Design decision: the homepage reads as a numbered specification — masthead, then
// 01 signal. It previously carried 01 work / 02 writing ahead of the GitHub panel;
// those are now reached from the nav and the hero's CTAs rather than duplicated here,
// which leaves the front page as the masthead plus one measured figure block.
import BaseLayout from '@/layouts/BaseLayout.astro';
import HeroSection from '@/components/HeroSection.astro';
import GitHubSection from '@/components/GitHubSection.astro';
---

<BaseLayout title="Home" description="Ryan Choi is a senior full-stack engineer specializing in Vue, React, Node.js, PHP, and design systems for fintech and SaaS teams.">

  <HeroSection />

  <div class="mx-auto max-w-5xl px-5 sm:px-8">

    <GitHubSection index="01" />

  </div>
</BaseLayout>
