---
// src/pages/index.astro
// Design decision: the homepage reads as a numbered specification — masthead, then
// 01 work / 02 writing / 03 signal. Work leads; the GitHub panel used to sit first,
// which put third-party metrics above Ryan's own projects.
import { getCollection } from 'astro:content';
import BaseLayout from '@/layouts/BaseLayout.astro';
import HeroSection from '@/components/HeroSection.astro';
import SectionHeader from '@/components/SectionHeader.astro';
import ProjectCard from '@/components/ProjectCard.astro';
import GitHubSection from '@/components/GitHubSection.astro';
import PostRow from '@/components/PostRow.astro';

const featuredProjects = (await getCollection('projects', ({ data }) => data.featured))
  .sort((a, b) => a.data.order - b.data.order)
  .slice(0, 3);

const latestPosts = (await getCollection('blog', ({ data }) => !data.draft))
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf())
  .slice(0, 3);
---

<BaseLayout title="Home" description="Ryan Choi is a senior frontend engineer specializing in Vue, React, design systems, and frontend infrastructure for fintech and SaaS teams.">

  <HeroSection />

  <div class="mx-auto max-w-5xl px-5 sm:px-8">

    {featuredProjects.length > 0 && (
      <section class="py-16 sm:py-20">
        <SectionHeader
          index="01"
          eyebrow="Selected work"
          title="Product, tooling, and frontend infrastructure"
          description="A focused sample. Each entry links straight to the live site or its source."
          href="/projects"
          linkLabel="All projects"
        />

        <div class="mt-10 border-t border-border">
          {featuredProjects.map((project, i) => (
            <ProjectCard
              index={i}
              title={project.data.title}
              description={project.data.description}
              tech={project.data.tech}
              url={project.data.url}
              github={project.data.github}
              cover={project.data.cover}
            />
          ))}
        </div>
      </section>
    )}

    {latestPosts.length > 0 && (
      <section class="py-16 sm:py-20">
        <SectionHeader
          index="02"
          eyebrow="Writing"
          title="Notes on engineering craft"
          description="Short essays on frontend systems, tooling, and building reliable user interfaces."
          href="/blog"
          linkLabel="All posts"
        />

        <div class="mt-10 border-t border-border">
          {latestPosts.map((post) => (
            <PostRow
              title={post.data.title}
              date={post.data.date}
              slug={post.id.replace(/\.md$/, '')}
              tags={post.data.tags}
            />
          ))}
        </div>
      </section>
    )}

    <GitHubSection />

  </div>
</BaseLayout>
