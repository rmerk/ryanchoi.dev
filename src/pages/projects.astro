---
// src/pages/projects.astro
// Design decision: the project index is a numbered ruled list, not a card grid —
// the same rows the homepage uses, but promoted to h2 since they are the page.
import { getCollection } from 'astro:content';
import BaseLayout from '@/layouts/BaseLayout.astro';
import PageHeader from '@/components/PageHeader.astro';
import ProjectCard from '@/components/ProjectCard.astro';

const projects = (await getCollection('projects'))
  .sort((a, b) => a.data.order - b.data.order);
---

<BaseLayout title="Projects" description="Selected projects from Ryan Choi, including product interfaces, frontend infrastructure, developer tools, and open-source experiments.">
  <div class="mx-auto max-w-5xl px-5 py-16 sm:px-8 sm:py-24">
    <PageHeader
      eyebrow="Projects"
      title="Selected product, tooling, and open-source work."
      lede="A mix of shipped interfaces, experiments, and engineering tools that show how I think about frontend systems."
    />

    <div class="mt-12">
      <p class="label pb-3 text-muted-soft">
        {projects.length} {projects.length === 1 ? 'entry' : 'entries'}
      </p>

      <div class="border-t border-border">
        {projects.map((project, i) => (
          <ProjectCard
            index={i}
            headingLevel={2}
            title={project.data.title}
            description={project.data.description}
            tech={project.data.tech}
            url={project.data.url}
            github={project.data.github}
            cover={project.data.cover}
          />
        ))}
      </div>
    </div>
  </div>
</BaseLayout>
