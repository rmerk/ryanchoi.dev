---
// src/pages/resume.astro
// Design decision: the IDE motif is the most site-native page in this direction,
// so the interaction is preserved and only the shell is retuned — squared edges,
// hairline rules, and syntax tones from the --color-code-* scale.
import BaseLayout from '@/layouts/BaseLayout.astro';
import PageHeader from '@/components/PageHeader.astro';
import { experience, education, skills } from '@/data/resume';
import { buildTimeline } from '@/data/timeline';

// The timeline tab is the one document in this workspace that is not code, which is
// why it carries no line numbers and why its tab has no file extension — an editor
// showing a rendered view rather than a source file. It is the only figure on the
// site derived from a decade of hand-authored content rather than an API, and the
// only one that is fully hermetic: no network, no token, no fallback path.
const timeline = buildTimeline();

let line = 0;
const indents = ['', 'pl-[2ch]', 'pl-[4ch]', 'pl-[6ch]'] as const;

function ln(): string {
  return String(++line);
}

function resetLn(): void {
  line = 0;
}

function ind(n: number): string {
  return indents[n] ?? '';
}
---

<BaseLayout title="Resume" description="Ryan Choi's frontend engineering resume, with experience across Vue, React, design systems, fintech, SaaS, and frontend infrastructure.">
  <div class="mx-auto max-w-5xl px-5 py-16 sm:px-8 sm:py-24">
    <PageHeader
      eyebrow="Resume"
      title="Experience in a format engineers can scan."
      lede="A compact view of roles, skills, and education with the structure of a TypeScript workspace."
    />

    <!-- Editor window -->
    <div class="mt-12 overflow-hidden border border-border bg-surface">

      <!-- Title bar -->
      <div class="flex items-center border-b border-border bg-surface-raised px-4 py-2.5">
        <div class="mr-4 flex gap-1.5">
          <span class="h-2.5 w-2.5 bg-border-strong" aria-hidden="true"></span>
          <span class="h-2.5 w-2.5 bg-border-strong" aria-hidden="true"></span>
          <span class="h-2.5 w-2.5 bg-border-strong" aria-hidden="true"></span>
        </div>
        <span class="label flex-1 text-center text-muted">resume.ts</span>
        <div class="w-[46px]"></div> <!-- Spacer to center title -->
      </div>

      <!-- Tab bar -->
      <div class="tab-scroll flex overflow-x-auto border-b border-border bg-bg" role="tablist">
        <button id="tab-experience" type="button" class="editor-tab active-tab label cursor-pointer whitespace-nowrap border-r border-border px-4 py-2.5" data-tab="experience" role="tab" aria-selected="true" aria-controls="experience" tabindex="0">
          experience.ts
        </button>
        <button id="tab-skills" type="button" class="editor-tab label cursor-pointer whitespace-nowrap border-r border-border px-4 py-2.5" data-tab="skills" role="tab" aria-selected="false" aria-controls="skills" tabindex="-1">
          skills.ts
        </button>
        <button id="tab-education" type="button" class="editor-tab label cursor-pointer whitespace-nowrap border-r border-border px-4 py-2.5" data-tab="education" role="tab" aria-selected="false" aria-controls="education" tabindex="-1">
          education.ts
        </button>
        <button id="tab-timeline" type="button" class="editor-tab label cursor-pointer whitespace-nowrap border-r border-border px-4 py-2.5" data-tab="timeline" role="tab" aria-selected="false" aria-controls="timeline" tabindex="-1">
          timeline
        </button>
      </div>

      <!-- Editor body -->
      <div class="flex">
        <!-- Line numbers + content -->
        <div class="min-w-0 flex-1 overflow-hidden">
          <div id="editor-content" class="p-4 font-mono text-xs leading-relaxed sm:p-6 sm:text-sm">
            {resetLn()}
            <section id="experience" role="tabpanel" aria-labelledby="tab-experience">
              <div class="code-line" data-line={ln()}><span class="text-muted italic">// Experience</span></div>
              <div class="code-line" data-line={ln()}><span>&nbsp;</span></div>
              <div class="code-line" data-line={ln()}>
                <span><span class="text-code-keyword">interface</span> <span class="text-code-type">Role</span> <span class="text-muted">{'{'}</span></span>
              </div>
              <div class="code-line" data-line={ln()}>
                <span class={ind(1)}>role<span class="text-muted">:</span> <span class="text-code-type">string</span><span class="text-muted">;</span></span>
              </div>
              <div class="code-line" data-line={ln()}>
                <span class={ind(1)}>company<span class="text-muted">:</span> <span class="text-code-type">string</span><span class="text-muted">;</span></span>
              </div>
              <div class="code-line" data-line={ln()}>
                <span class={ind(1)}>period<span class="text-muted">:</span> <span class="text-code-type">string</span><span class="text-muted">;</span></span>
              </div>
              <div class="code-line" data-line={ln()}>
                <span class={ind(1)}>highlights<span class="text-muted">:</span> <span class="text-code-type">string</span><span class="text-muted">[];</span></span>
              </div>
              <div class="code-line" data-line={ln()}><span class="text-muted">{'}'}</span></div>
              <div class="code-line" data-line={ln()}><span>&nbsp;</span></div>
              <div class="code-line" data-line={ln()}>
                <span><span class="text-code-keyword">const</span> experience<span class="text-muted">:</span> <span class="text-code-type">Role</span><span class="text-muted">[] = [</span></span>
              </div>

              {experience.map((job, i) => (
                <>
                  <div class="code-line" data-line={ln()}><span class={`text-muted ${ind(1)}`}>{'{'}</span></div>
                  <div class="code-line" data-line={ln()}>
                    <span class={ind(2)}>role<span class="text-muted">:</span> <span class="text-code-string">"{job.role}"</span><span class="text-muted">,</span></span>
                  </div>
                  <div class="code-line" data-line={ln()}>
                    <span class={ind(2)}>company<span class="text-muted">:</span> <a href={job.url} target="_blank" rel="noopener noreferrer" class="text-accent hover:underline">"{job.company}"</a><span class="text-muted">,</span></span>
                  </div>
                  <div class="code-line" data-line={ln()}>
                    <span class={ind(2)}>period<span class="text-muted">:</span> <span class="text-code-string">"{job.start} → {job.end}"</span><span class="text-muted">,</span></span>
                  </div>
                  <div class="code-line" data-line={ln()}>
                    <span class={ind(2)}>highlights<span class="text-muted">: [</span></span>
                  </div>
                  {job.bullets.map((bullet) => (
                    <div class="code-line" data-line={ln()}>
                      <span class={ind(3)}><span class="text-code-string">"{bullet}"</span><span class="text-muted">,</span></span>
                    </div>
                  ))}
                  <div class="code-line" data-line={ln()}><span class={`text-muted ${ind(2)}`}>],</span></div>
                  <div class="code-line" data-line={ln()}><span class={`text-muted ${ind(1)}`}>{'}'},</span></div>
                  {i < experience.length - 1 && (
                    <div class="code-line" data-line={ln()}><span>&nbsp;</span></div>
                  )}
                </>
              ))}

              <div class="code-line" data-line={ln()}><span class="text-muted">];</span></div>
            </section>

            {resetLn()}
            <section id="skills" role="tabpanel" aria-labelledby="tab-skills" hidden>
              <div class="code-line" data-line={ln()}><span class="text-muted italic">// Skills</span></div>
              <div class="code-line" data-line={ln()}><span>&nbsp;</span></div>
              <div class="code-line" data-line={ln()}>
                <span><span class="text-code-keyword">type</span> <span class="text-code-type">Stack</span> <span class="text-muted">= {'{'}</span></span>
              </div>

              {Object.entries(skills).map(([category, items]) => (
                <div class="code-line" data-line={ln()}>
                  <span class={ind(1)}>{category.toLowerCase()}<span class="text-muted">:</span> <span class="text-muted">[</span>{items.map((item, i) => <><span class="text-code-string">"{item}"</span>{i < items.length - 1 && <span class="text-muted">, </span>}</> )}<span class="text-muted">],</span></span>
                </div>
              ))}

              <div class="code-line" data-line={ln()}><span class="text-muted">{'}'};</span></div>
            </section>

            {resetLn()}
            <section id="education" role="tabpanel" aria-labelledby="tab-education" hidden>
              <div class="code-line" data-line={ln()}><span class="text-muted italic">// Education</span></div>
              <div class="code-line" data-line={ln()}><span>&nbsp;</span></div>

              {education.map((edu) => (
                <>
                  <div class="code-line" data-line={ln()}>
                    <span><span class="text-code-keyword">const</span> education <span class="text-muted">= {'{'}</span></span>
                  </div>
                  <div class="code-line" data-line={ln()}>
                    <span class={ind(1)}>credential<span class="text-muted">:</span> <span class="text-code-string">"{edu.credential}"</span><span class="text-muted">,</span></span>
                  </div>
                  <div class="code-line" data-line={ln()}>
                    <span class={ind(1)}>institution<span class="text-muted">:</span> <a href={edu.url} target="_blank" rel="noopener noreferrer" class="text-accent hover:underline">"{edu.institution}"</a><span class="text-muted">,</span></span>
                  </div>
                  <div class="code-line" data-line={ln()}>
                    <span class={ind(1)}>period<span class="text-muted">:</span> <span class="text-code-string">"{edu.start} → {edu.end}"</span><span class="text-muted">,</span></span>
                  </div>
                  <div class="code-line" data-line={ln()}><span class="text-muted">{'}'};</span></div>
                </>
              ))}
            </section>

            <section
              id="timeline"
              role="tabpanel"
              aria-labelledby="tab-timeline"
              data-status={`${timeline.bars[0].period.split(' – ')[0]} – ${timeline.asOf}`}
              hidden
            >
              <p class="text-muted italic">
                {'// '}{timeline.totalMonths} months elapsed, {timeline.employedMonths} employed
                {timeline.gaps.length > 0 && ` · ${timeline.gaps.length} gap${timeline.gaps.length === 1 ? '' : 's'}`}
              </p>

              <table class="gantt mt-5">
                <caption class="sr-only">
                  Employment timeline by employer, {timeline.bars[0].period.split(' – ')[0]} to {timeline.asOf}.
                  Bar lengths are proportional to duration.
                </caption>
                <thead>
                  <tr>
                    <th scope="col" class="gantt-company"><span class="sr-only">Employer</span></th>
                    <th scope="col" class="gantt-axis">
                      <span class="sr-only">Period</span>
                      {timeline.ticks.map(({ year, offset }, i) => (
                        <span class={`gantt-tick${i % 2 === 1 ? ' is-minor' : ''}`} style={`left:${offset}%`} aria-hidden="true">
                          <span class="gantt-tick-year">{String(year).slice(2)}</span>
                        </span>
                      ))}
                    </th>
                    <th scope="col" class="gantt-duration"><span class="sr-only">Duration</span></th>
                  </tr>
                </thead>
                <tbody>
                  {timeline.bars.map((bar) => (
                    <tr>
                      <th scope="row" class="gantt-company">
                        <a href={bar.url} target="_blank" rel="noopener noreferrer" class="text-accent hover:underline">{bar.company}</a>
                      </th>
                      <td class="gantt-track">
                        <span class="sr-only">{bar.period}</span>
                        {timeline.ticks.map(({ offset }) => (
                          <span class="gantt-grid" style={`left:${offset}%`} aria-hidden="true"></span>
                        ))}
                        <span
                          class={`gantt-bar${bar.ongoing ? ' is-current' : ''}`}
                          style={`left:${bar.offset}%;width:${bar.width}%`}
                          aria-hidden="true"
                        >
                          {bar.segments.map((segment, i) => (
                            <span
                              class={`gantt-seg${i > 0 ? ' is-divided' : ''}`}
                              style={`left:${segment.offset}%;width:${segment.width}%`}
                            ><span class="sr-only">{segment.role}</span></span>
                          ))}
                        </span>
                      </td>
                      <td class="gantt-duration">{bar.label}</td>
                    </tr>
                  ))}
                </tbody>
              </table>

              <dl class="gantt-legend mt-6">
                {timeline.bars.flatMap((bar) => bar.segments.map((segment) => (
                  <div class="gantt-legend-row">
                    <dt class="text-code-string">{segment.role}</dt>
                    <dd class="text-muted">{segment.period} · {segment.label}</dd>
                  </div>
                )))}
              </dl>

              {timeline.gaps.length > 0 && (
                <p class="mt-5 text-muted">
                  {'// '}Gaps between employers are drawn, not closed up:
                  {' '}{timeline.gaps.map((gap) => `${gap.months} mo`).join(', ')}.
                </p>
              )}

              <p class="mt-2 text-muted-soft">{'// '}Ongoing role measured to {timeline.asOf}, the month this page was built.</p>
            </section>
          </div>
        </div>

        <!-- Minimap (desktop only) -->
        <div class="relative hidden w-20 overflow-hidden border-l border-border bg-bg lg:block" aria-hidden="true">
          <div id="minimap-content" class="absolute top-0 left-0 w-[540px] origin-top-left pointer-events-none" style="transform: scale(0.148); filter: blur(0.5px); opacity: 0.5;"></div>
        </div>
      </div>

      <!-- Status bar -->
      <div class="flex items-center justify-between border-t border-border bg-surface-raised px-4 py-2 font-mono text-[11px] text-muted">
        <div class="flex items-center gap-3">
          <span class="flex items-center gap-1">
            <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <line x1="6" y1="3" x2="6" y2="15" /><circle cx="18" cy="6" r="3" /><circle cx="6" cy="18" r="3" /><path d="M18 9a9 9 0 0 1-9 9" />
            </svg>
            <span class="text-accent">main</span>
          </span>
        </div>
        <div class="flex items-center gap-3">
          <span class="hidden sm:inline">
            <span class="text-code-type">✓</span> TypeScript
          </span>
          <span class="hidden sm:inline">UTF-8</span>
          <span id="editor-status" class="hidden sm:inline">Ln {line}, Col 1</span>
        </div>
      </div>

    </div>
  </div>
<script>
  function setupTabs() {
    const sections = document.querySelectorAll<HTMLElement>('#experience, #skills, #education, #timeline');
    const tabs = document.querySelectorAll<HTMLButtonElement>('.editor-tab');
    const status = document.getElementById('editor-status');

    if (!sections.length || !tabs.length) return;

    function switchTab(targetId: string, shouldFocus = false) {
      sections.forEach((section) => {
        section.hidden = section.id !== targetId;
        // The status bar used to render one static line count for every tab — the
        // last section's, so it was wrong on three tabs out of four. Counting the
        // open document keeps it honest, and the timeline, which has no lines,
        // declares its own status instead.
        if (status && section.id === targetId) {
          status.textContent = section.dataset.status ?? `Ln ${section.querySelectorAll('.code-line').length}, Col 1`;
        }
      });
      tabs.forEach((tab) => {
        const isActive = tab.dataset.tab === targetId;
        tab.classList.toggle('active-tab', isActive);
        tab.setAttribute('aria-selected', String(isActive));
        tab.tabIndex = isActive ? 0 : -1;
        if (isActive && shouldFocus) {
          tab.focus();
        }
      });
      setupMinimap();
    }

    function moveTabFocus(currentTab: HTMLButtonElement, direction: 'previous' | 'next' | 'first' | 'last') {
      const tabList = Array.from(tabs);
      const currentIndex = tabList.indexOf(currentTab);
      let nextIndex = currentIndex;

      if (direction === 'first') nextIndex = 0;
      if (direction === 'last') nextIndex = tabList.length - 1;
      if (direction === 'previous') nextIndex = currentIndex === 0 ? tabList.length - 1 : currentIndex - 1;
      if (direction === 'next') nextIndex = currentIndex === tabList.length - 1 ? 0 : currentIndex + 1;

      const targetId = tabList[nextIndex]?.dataset.tab;
      if (targetId) switchTab(targetId, true);
    }

    tabs.forEach((tab) => {
      tab.addEventListener('click', () => {
        const targetId = tab.dataset.tab;
        if (targetId) switchTab(targetId);
      });
      tab.addEventListener('keydown', (event) => {
        if (event.key === 'ArrowLeft') {
          event.preventDefault();
          moveTabFocus(tab, 'previous');
        }
        if (event.key === 'ArrowRight') {
          event.preventDefault();
          moveTabFocus(tab, 'next');
        }
        if (event.key === 'Home') {
          event.preventDefault();
          moveTabFocus(tab, 'first');
        }
        if (event.key === 'End') {
          event.preventDefault();
          moveTabFocus(tab, 'last');
        }
      });
    });

    // Show experience by default, hide others
    switchTab('experience');
  }

  function setupMinimap() {
    const source = document.getElementById('editor-content');
    const target = document.getElementById('minimap-content');
    if (source && target) {
      const clone = source.cloneNode(true) as HTMLElement;
      clone.inert = true;
      // Cloning #editor-content copies every id with it, so the document carried two
      // of #editor-content, #experience, #skills and #education. Duplicate ids are
      // invalid, and they make getElementById and every in-page anchor ambiguous.
      clone.removeAttribute('id');
      clone.querySelectorAll<HTMLElement>('[id]').forEach((element) => element.removeAttribute('id'));
      clone.querySelectorAll<HTMLElement>('a, button, input, select, textarea, [tabindex]').forEach((element) => {
        element.setAttribute('tabindex', '-1');
        element.setAttribute('aria-hidden', 'true');
        element.removeAttribute('href');
      });
      target.replaceChildren(clone);
    }
  }

  setupTabs();
  document.addEventListener('astro:after-swap', setupTabs);
</script>
</BaseLayout>

<style>
  .code-line {
    display: grid;
    grid-template-columns: 3rem 1fr;
    min-height: 1.5em;
  }
  .code-line::before {
    content: attr(data-line);
    text-align: right;
    padding-right: 1rem;
    /* Recessive but still legible — this was --color-muted at 0.5 opacity, which
       put the line numbers well under the AA floor. */
    color: var(--color-muted-soft);
    user-select: none;
  }
  .code-line > span {
    min-width: 0;
    overflow-wrap: anywhere;
    word-break: break-word;
  }
  @media (max-width: 640px) {
    .code-line {
      grid-template-columns: 2rem 1fr;
    }
    .code-line::before {
      padding-right: 0.5rem;
      font-size: 0.65rem;
    }
  }
  .editor-tab {
    color: var(--color-muted);
    border-bottom: 2px solid transparent;
    background: transparent;
    transition: color 0.15s, border-color 0.15s, background-color 0.15s;
  }
  .editor-tab:hover {
    color: var(--color-text);
    background: var(--color-surface);
  }
  .editor-tab.active-tab {
    color: var(--color-accent);
    border-bottom-color: var(--color-accent);
    background: var(--color-surface);
  }
  .tab-scroll::-webkit-scrollbar { display: none; }
  .tab-scroll { -ms-overflow-style: none; scrollbar-width: none; }

  /* Employment Gantt. A real <table> rather than SVG: the rows are tabular data with
     a period and a duration, so the accessible reading is the useful one, the text
     stays selectable, and both themes come for free from the token variables. Only
     the bar geometry is drawn. */
  .gantt {
    width: 100%;
    border-collapse: collapse;
    table-layout: fixed;
  }
  .gantt th,
  .gantt td {
    padding: 0;
  }
  /* The header cells carry these same classes so `table-layout: fixed` has a first
     row to take column widths from. Their labels are wrapped in .sr-only spans rather
     than the cells being .sr-only themselves — that class is position:absolute, which
     takes the cell out of flow and collapses the whole column model. */
  .gantt-company {
    width: 12.5rem;
    padding-right: 1rem;
    text-align: left;
    font-weight: 400;
    vertical-align: middle;
    overflow-wrap: anywhere;
  }
  .gantt-duration {
    width: 5.5rem;
    padding-left: 0.75rem;
    text-align: right;
    color: var(--color-muted);
    font-variant-numeric: tabular-nums;
    vertical-align: middle;
  }
  .gantt-axis {
    position: relative;
    height: 1.25rem;
    font-weight: 400;
  }
  .gantt-tick {
    position: absolute;
    top: 0;
    bottom: 0;
    width: 0;
    border-left: 1px solid var(--color-border);
  }
  .gantt-tick-year {
    position: absolute;
    bottom: 0;
    left: 2px;
    color: var(--color-muted-soft);
    font-size: 0.625rem;
    line-height: 1;
  }
  /* Year gridlines continue behind the bars. Drawn as real positioned spans rather
     than a repeating-linear-gradient: percentage background-position resolves against
     (container − image), which is zero when the image fills the box, so a gradient
     could not be offset to a first tick that is not at 0%. Spans take the same
     percentages the bars do and cannot drift out of alignment with them. */
  .gantt-track {
    position: relative;
    height: 1.75rem;
  }
  .gantt-grid {
    position: absolute;
    top: 0;
    bottom: 0;
    width: 0;
    border-left: 1px solid var(--color-border);
  }
  .gantt-bar {
    position: absolute;
    top: 50%;
    height: 0.6875rem;
    transform: translateY(-50%);
    background: var(--color-muted-soft);
    /* Minimum width so a one-month role never renders as a hairline nobody can see. */
    min-width: 3px;
  }
  .gantt-bar.is-current {
    background: var(--color-accent);
  }
  /* A promotion divides a tenure, it does not end one. The divider is an eraser in the
     page colour rather than a gap between two bars, so the continuity stays visible. */
  .gantt-seg {
    position: absolute;
    top: 0;
    bottom: 0;
  }
  .gantt-seg.is-divided {
    border-left: 2px solid var(--color-bg);
  }
  .gantt-legend-row {
    display: grid;
    gap: 0 1rem;
    padding: 0.375rem 0;
    border-bottom: 1px solid var(--color-border);
  }
  @media (min-width: 640px) {
    .gantt-legend-row {
      grid-template-columns: 1fr auto;
      align-items: baseline;
    }
  }
  /* Below sm the label column would leave the track too narrow to read a decade in,
     so the company name moves above its own bar and the duration joins the legend. */
  @media (max-width: 639px) {
    /* thead must be in this list. Leaving it as a table-header-group wrapping block
       children makes the browser generate an anonymous table box around it, which
       collapses the axis to its content width and stacks every year label on top of
       the next. The bars looked right because tbody was converted and they were not. */
    .gantt,
    .gantt thead,
    .gantt tbody,
    .gantt tr,
    .gantt th,
    .gantt td {
      display: block;
      width: auto;
    }
    /* The axis stays. Eleven year labels will not fit across 280px, so every other
       one is dropped — the gridlines behind each bar keep the full year resolution,
       and the legend below carries exact dates for every role. */
    .gantt thead tr {
      margin-bottom: 0.25rem;
    }
    .gantt thead .gantt-company,
    .gantt thead .gantt-duration {
      display: none;
    }
    .gantt-tick.is-minor .gantt-tick-year {
      display: none;
    }
    .gantt tbody tr + tr {
      margin-top: 0.75rem;
    }
    .gantt-company {
      padding: 0 0 0.25rem;
    }
    .gantt-duration {
