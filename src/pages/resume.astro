---
// src/pages/resume.astro
// Design decision: preserve the IDE-inspired resume interaction while polishing
// the shell with quieter surfaces, stronger hierarchy, and the cyan token system.
import BaseLayout from '@/layouts/BaseLayout.astro';
import { experience, education, skills } from '@/data/resume';

let line = 0;
const indents = ['', 'pl-[2ch]', 'pl-[4ch]', 'pl-[6ch]'] as const;

function ln(): string {
  return String(++line);
}

function resetLn(): void {
  line = 0;
}

function ind(n: number): string {
  return indents[n] ?? '';
}
---

<BaseLayout title="Resume" description="Ryan Choi's work experience and skills">
  <div class="mx-auto max-w-6xl px-4 py-16 sm:px-6 sm:py-24">
    <div class="mb-10 max-w-3xl">
      <p class="mb-3 font-mono text-xs uppercase tracking-[0.2em] text-accent">Resume</p>
      <h1 class="text-4xl font-semibold tracking-tight text-text text-balance sm:text-5xl">Experience in a format engineers can scan.</h1>
      <p class="mt-5 text-lg leading-8 text-muted">A compact view of roles, skills, and education with the structure of a TypeScript workspace.</p>
    </div>

    <!-- Editor window -->
    <div class="overflow-hidden rounded-3xl border border-border bg-surface/80 shadow-2xl shadow-black/20">

      <!-- Title bar -->
      <div class="flex items-center border-b border-border bg-surface px-4 py-3">
        <div class="flex gap-1.5 mr-4">
          <span class="h-3 w-3 rounded-full bg-[#ff5f57]" aria-hidden="true"></span>
          <span class="h-3 w-3 rounded-full bg-[#febc2e]" aria-hidden="true"></span>
          <span class="h-3 w-3 rounded-full bg-[#28c840]" aria-hidden="true"></span>
        </div>
        <span class="flex-1 text-center font-mono text-xs text-muted">resume.ts - ryanchoi.dev</span>
        <div class="w-[54px]"></div> <!-- Spacer to center title -->
      </div>

      <!-- Tab bar -->
      <div class="tab-scroll flex overflow-x-auto border-b border-border bg-bg/70" role="tablist">
        <button type="button" class="editor-tab active-tab cursor-pointer whitespace-nowrap border-r border-border px-4 py-2.5 font-mono text-xs focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-accent" data-tab="experience" role="tab" aria-selected="true">
          experience.ts
        </button>
        <button type="button" class="editor-tab cursor-pointer whitespace-nowrap border-r border-border px-4 py-2.5 font-mono text-xs focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-accent" data-tab="skills" role="tab" aria-selected="false">
          skills.ts
        </button>
        <button type="button" class="editor-tab cursor-pointer whitespace-nowrap border-r border-border px-4 py-2.5 font-mono text-xs focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-accent" data-tab="education" role="tab" aria-selected="false">
          education.ts
        </button>
      </div>

      <!-- Editor body -->
      <div class="flex">
        <!-- Line numbers + content -->
        <div class="min-w-0 flex-1 overflow-hidden">
          <div id="editor-content" class="p-4 font-mono text-xs leading-relaxed sm:p-6 sm:text-sm">
            {resetLn()}
            <section id="experience">
              <div class="code-line" data-line={ln()}><span class="text-muted italic">// Experience</span></div>
              <div class="code-line" data-line={ln()}><span>&nbsp;</span></div>
              <div class="code-line" data-line={ln()}>
                <span><span class="text-accent">interface</span> <span class="text-accent-secondary">Role</span> <span class="text-muted">{'{'}</span></span>
              </div>
              <div class="code-line" data-line={ln()}>
                <span class={ind(1)}>role<span class="text-muted">:</span> <span class="text-accent-secondary">string</span><span class="text-muted">;</span></span>
              </div>
              <div class="code-line" data-line={ln()}>
                <span class={ind(1)}>company<span class="text-muted">:</span> <span class="text-accent-secondary">string</span><span class="text-muted">;</span></span>
              </div>
              <div class="code-line" data-line={ln()}>
                <span class={ind(1)}>period<span class="text-muted">:</span> <span class="text-accent-secondary">string</span><span class="text-muted">;</span></span>
              </div>
              <div class="code-line" data-line={ln()}>
                <span class={ind(1)}>highlights<span class="text-muted">:</span> <span class="text-accent-secondary">string</span><span class="text-muted">[];</span></span>
              </div>
              <div class="code-line" data-line={ln()}><span class="text-muted">{'}'}</span></div>
              <div class="code-line" data-line={ln()}><span>&nbsp;</span></div>
              <div class="code-line" data-line={ln()}>
                <span><span class="text-accent">const</span> experience<span class="text-muted">:</span> <span class="text-accent-secondary">Role</span><span class="text-muted">[] = [</span></span>
              </div>

              {experience.map((job, i) => (
                <>
                  <div class="code-line" data-line={ln()}><span class={`text-muted ${ind(1)}`}>{'{'}</span></div>
                  <div class="code-line" data-line={ln()}>
                    <span class={ind(2)}>role<span class="text-muted">:</span> <span class="text-green-400">"{job.role}"</span><span class="text-muted">,</span></span>
                  </div>
                  <div class="code-line" data-line={ln()}>
                    <span class={ind(2)}>company<span class="text-muted">:</span> <a href={job.url} target="_blank" rel="noopener noreferrer" class="text-accent hover:underline">"{job.company}"</a><span class="text-muted">,</span></span>
                  </div>
                  <div class="code-line" data-line={ln()}>
                    <span class={ind(2)}>period<span class="text-muted">:</span> <span class="text-green-400">"{job.start} → {job.end}"</span><span class="text-muted">,</span></span>
                  </div>
                  <div class="code-line" data-line={ln()}>
                    <span class={ind(2)}>highlights<span class="text-muted">: [</span></span>
                  </div>
                  {job.bullets.map((bullet) => (
                    <div class="code-line" data-line={ln()}>
                      <span class={ind(3)}><span class="text-green-400">"{bullet}"</span><span class="text-muted">,</span></span>
                    </div>
                  ))}
                  <div class="code-line" data-line={ln()}><span class={`text-muted ${ind(2)}`}>],</span></div>
                  <div class="code-line" data-line={ln()}><span class={`text-muted ${ind(1)}`}>{'}'},</span></div>
                  {i < experience.length - 1 && (
                    <div class="code-line" data-line={ln()}><span>&nbsp;</span></div>
                  )}
                </>
              ))}

              <div class="code-line" data-line={ln()}><span class="text-muted">];</span></div>
            </section>

            {resetLn()}
            <section id="skills">
              <div class="code-line" data-line={ln()}><span class="text-muted italic">// Skills</span></div>
              <div class="code-line" data-line={ln()}><span>&nbsp;</span></div>
              <div class="code-line" data-line={ln()}>
                <span><span class="text-accent">type</span> <span class="text-accent-secondary">Stack</span> <span class="text-muted">= {'{'}</span></span>
              </div>

              {Object.entries(skills).map(([category, items]) => (
                <div class="code-line" data-line={ln()}>
                  <span class={ind(1)}>{category.toLowerCase()}<span class="text-muted">:</span> <span class="text-muted">[</span>{items.map((item, i) => <><span class="text-green-400">"{item}"</span>{i < items.length - 1 && <span class="text-muted">, </span>}</> )}<span class="text-muted">],</span></span>
                </div>
              ))}

              <div class="code-line" data-line={ln()}><span class="text-muted">{'}'};</span></div>
            </section>

            {resetLn()}
            <section id="education">
              <div class="code-line" data-line={ln()}><span class="text-muted italic">// Education</span></div>
              <div class="code-line" data-line={ln()}><span>&nbsp;</span></div>

              {education.map((edu) => (
                <>
                  <div class="code-line" data-line={ln()}>
                    <span><span class="text-accent">const</span> education <span class="text-muted">= {'{'}</span></span>
                  </div>
                  <div class="code-line" data-line={ln()}>
                    <span class={ind(1)}>credential<span class="text-muted">:</span> <span class="text-green-400">"{edu.credential}"</span><span class="text-muted">,</span></span>
                  </div>
                  <div class="code-line" data-line={ln()}>
                    <span class={ind(1)}>institution<span class="text-muted">:</span> <a href={edu.url} target="_blank" rel="noopener noreferrer" class="text-accent hover:underline">"{edu.institution}"</a><span class="text-muted">,</span></span>
                  </div>
                  <div class="code-line" data-line={ln()}>
                    <span class={ind(1)}>period<span class="text-muted">:</span> <span class="text-green-400">"{edu.start} → {edu.end}"</span><span class="text-muted">,</span></span>
                  </div>
                  <div class="code-line" data-line={ln()}><span class="text-muted">{'}'};</span></div>
                </>
              ))}
            </section>
          </div>
        </div>

        <!-- Minimap (desktop only) -->
        <div class="relative hidden w-20 overflow-hidden border-l border-border bg-bg/55 lg:block" aria-hidden="true">
          <div id="minimap-content" class="absolute top-0 left-0 w-[540px] origin-top-left pointer-events-none" style="transform: scale(0.148); filter: blur(0.5px); opacity: 0.5;"></div>
        </div>
      </div>

      <!-- Status bar -->
      <div class="flex items-center justify-between border-t border-border bg-surface px-4 py-2 font-mono text-[11px] text-muted">
        <div class="flex items-center gap-3">
          <span class="flex items-center gap-1">
            <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <line x1="6" y1="3" x2="6" y2="15" /><circle cx="18" cy="6" r="3" /><circle cx="6" cy="18" r="3" /><path d="M18 9a9 9 0 0 1-9 9" />
            </svg>
            <span class="text-accent">main</span>
          </span>
        </div>
        <div class="flex items-center gap-3">
          <span class="hidden sm:inline">
            <span class="text-green-400">✓</span> TypeScript
          </span>
          <span class="hidden sm:inline">UTF-8</span>
          <span class="hidden sm:inline">Ln {line}, Col 1</span>
        </div>
      </div>

    </div>
  </div>
<script>
  function setupTabs() {
    const sections = document.querySelectorAll<HTMLElement>('#experience, #skills, #education');
    const tabs = document.querySelectorAll<HTMLButtonElement>('.editor-tab');

    if (!sections.length || !tabs.length) return;

    function switchTab(targetId: string) {
      sections.forEach((section) => {
        section.style.display = section.id === targetId ? '' : 'none';
      });
      tabs.forEach((tab) => {
        const isActive = tab.dataset.tab === targetId;
        tab.classList.toggle('active-tab', isActive);
        tab.setAttribute('aria-selected', String(isActive));
      });
      setupMinimap();
    }

    tabs.forEach((tab) => {
      tab.addEventListener('click', () => {
        const targetId = tab.dataset.tab;
        if (targetId) switchTab(targetId);
      });
    });

    // Show experience by default, hide others
    switchTab('experience');
  }

  function setupMinimap() {
    const source = document.getElementById('editor-content');
    const target = document.getElementById('minimap-content');
    if (source && target) {
      target.replaceChildren(source.cloneNode(true));
    }
  }

  setupTabs();
  document.addEventListener('astro:after-swap', setupTabs);
</script>
</BaseLayout>

<style>
  .code-line {
    display: grid;
    grid-template-columns: 3rem 1fr;
    min-height: 1.5em;
  }
  .code-line::before {
    content: attr(data-line);
    text-align: right;
    padding-right: 1rem;
    color: var(--color-muted);
    opacity: 0.5;
    user-select: none;
  }
  .code-line > span {
    min-width: 0;
    overflow-wrap: anywhere;
    word-break: break-word;
  }
  @media (max-width: 640px) {
    .code-line {
      grid-template-columns: 2rem 1fr;
    }
    .code-line::before {
      padding-right: 0.5rem;
      font-size: 0.65rem;
    }
  }
  .editor-tab {
    color: var(--color-muted);
    border-bottom: 2px solid transparent;
    background: transparent;
    transition: color 0.15s, border-color 0.15s, background-color 0.15s;
  }
  .editor-tab:hover {
    color: var(--color-text);
    background: color-mix(in srgb, var(--color-surface) 65%, transparent);
  }
  .editor-tab.active-tab {
    color: var(--color-text);
    border-bottom-color: var(--color-accent);
    background: color-mix(in srgb, var(--color-accent) 8%, var(--color-surface));
  }
  .tab-scroll::-webkit-scrollbar { display: none; }
  .tab-scroll { -ms-overflow-style: none; scrollbar-width: none; }
</style>
